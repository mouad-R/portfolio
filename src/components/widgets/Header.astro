---
import Logo from '~/components/Logo.astro';

interface Link {
  text: string;
  href?: string;
  links?: Link[];
  hasBorder?: boolean;
}

export interface Props {
  actions?: Array<Record<string, unknown>>;
  showRssFeed?: boolean;
  position?: string;
  [key: string]: unknown;
  links?: Link[];
  isSticky?: boolean;
  showToggleTheme?: boolean;
}

const {
  links = [
    { text: 'Work', href: '/work' },
    { text: 'About & Services', href: '/about' },
    { text: 'Contact', href: '/contact', hasBorder: true },
  ],
} = Astro.props;
---

<header class="fixed top-4 inset-x-0 z-50 flex justify-center px-3 sm:px-6 pointer-events-none">
  <div
    class="pointer-events-auto w-full max-w-fit md:max-w-max rounded-2xl md:rounded-full bg-white/80 dark:bg-[#060b17]/85 backdrop-blur-2xl border border-sky-900/10 dark:border-white/10 shadow-lg shadow-sky-950/5 dark:shadow-2xl dark:shadow-black/60 transition-all duration-300"
  >
    <div class="flex items-center justify-between gap-3 md:gap-7 px-4 py-2">
      <a
        href="/"
        class="flex items-center flex-shrink-0 text-neutral-950 dark:text-white transition-opacity hover:opacity-80"
      >
        <Logo />
      </a>

      <nav class="hidden md:flex items-center gap-1">
        {
          links.map((item) =>
            item.links ? (
              <div class="relative group">
                <button class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-medium text-neutral-600 dark:text-neutral-300 group-hover:text-neutral-950 dark:group-hover:text-white rounded-full transition-colors">
                  <span>{item.text}</span>
                  <svg
                    class="w-3 h-3 opacity-60 transition-transform duration-200 group-hover:rotate-180"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </button>

                <div class="absolute top-full left-0 pt-2 opacity-0 pointer-events-none translate-y-1 group-hover:opacity-100 group-hover:pointer-events-auto group-hover:translate-y-0 transition-all duration-200 ease-out z-50 min-w-[190px]">
                  <div class="p-1.5 rounded-2xl bg-white/95 dark:bg-[#070d1d]/95 backdrop-blur-2xl border border-neutral-200/80 dark:border-white/10 shadow-xl shadow-sky-950/10 dark:shadow-black/70 flex flex-col gap-0.5">
                    {item.links.map((subItem) => (
                      <a
                        href={subItem.href}
                        class="px-3 py-2 text-xs font-medium text-neutral-600 dark:text-neutral-300 hover:text-sky-600 dark:hover:text-sky-400 hover:bg-sky-50 dark:hover:bg-white/[0.06] rounded-xl transition-all"
                      >
                        {subItem.text}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            ) : item.hasBorder ? (
              <a
                href={item.href}
                class="ml-2 px-3.5 py-1 text-xs font-semibold rounded-full border border-sky-600/30 dark:border-sky-400/40 bg-sky-500/10 text-sky-700 dark:text-sky-300 hover:bg-sky-500/20 hover:border-sky-500 transition-all shadow-sm"
              >
                {item.text}
              </a>
            ) : (
              <a
                href={item.href}
                class="px-3.5 py-1.5 text-xs font-medium text-neutral-600 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white rounded-full transition-colors"
              >
                {item.text}
              </a>
            )
          )
        }
      </nav>

      <div class="flex items-center gap-1">
        <button
          type="button"
          id="theme-toggle-btn"
          aria-label="Toggle color scheme"
          class="p-1.5 rounded-full text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/10 transition-colors"
        >
          <svg
            class="w-4 h-4 hidden dark:block"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path
              d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path
              d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path>
          </svg>
          <svg
            class="w-4 h-4 block dark:hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>

        <button
          type="button"
          id="mobile-menu-btn"
          aria-label="Toggle navigation"
          class="md:hidden p-1.5 rounded-full text-neutral-700 dark:text-neutral-300 hover:bg-black/5 dark:hover:bg-white/10 transition-colors"
        >
          <svg
            id="hamburger-icon"
            class="w-5 h-5 block"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line
              x1="4"
              x2="20"
              y1="18"
              y2="18"></line>
          </svg>
          <svg
            id="close-icon"
            class="w-5 h-5 hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <div
      id="mobile-menu-panel"
      class="hidden md:hidden px-4 pt-1 pb-4 border-t border-neutral-200/60 dark:border-white/10 flex-col gap-2"
    >
      {
        links.map((item) =>
          item.links ? (
            <div class="py-1">
              <span class="block px-2 text-[11px] font-mono uppercase tracking-wider text-sky-600 dark:text-sky-400 font-semibold mb-1">
                {item.text}
              </span>
              <div class="flex flex-col gap-1 pl-2 border-l border-sky-500/20 ml-2">
                {item.links.map((subItem) => (
                  <a
                    href={subItem.href}
                    class="mobile-nav-link py-1.5 px-2 text-xs font-medium text-neutral-700 dark:text-neutral-300 hover:text-sky-600 dark:hover:text-sky-400 rounded-lg transition-colors"
                  >
                    {subItem.text}
                  </a>
                ))}
              </div>
            </div>
          ) : item.hasBorder ? (
            <a
              href={item.href}
              class="mobile-nav-link mt-2 w-full py-2 text-center text-xs font-semibold rounded-xl border border-sky-600/30 dark:border-sky-400/40 bg-sky-500/10 text-sky-700 dark:text-sky-300 hover:bg-sky-500/20 transition-all block"
            >
              {item.text}
            </a>
          ) : (
            <a
              href={item.href}
              class="mobile-nav-link py-2 px-2 text-xs font-medium text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white rounded-lg transition-colors block"
            >
              {item.text}
            </a>
          )
        )
      }
    </div>
  </div>
</header>

<script>
  function setupHeader() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const menuPanel = document.getElementById('mobile-menu-panel');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (menuBtn && menuPanel && hamburgerIcon && closeIcon) {
      menuBtn.onclick = () => {
        const isOpen = !menuPanel.classList.contains('hidden');
        if (isOpen) {
          menuPanel.classList.add('hidden');
          menuPanel.classList.remove('flex');
          hamburgerIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        } else {
          menuPanel.classList.remove('hidden');
          menuPanel.classList.add('flex');
          hamburgerIcon.classList.add('hidden');
          closeIcon.classList.remove('hidden');
        }
      };

      document.querySelectorAll('.mobile-nav-link').forEach((link) => {
        link.addEventListener('click', () => {
          menuPanel.classList.add('hidden');
          menuPanel.classList.remove('flex');
          hamburgerIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        });
      });
    }

    const themeBtn = document.getElementById('theme-toggle-btn');
    if (themeBtn) {
      themeBtn.onclick = () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      };
    }
  }

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>
