---
// Cinematic Atmosphere: Animated Liquid Aurora, Studio Grid, Adaptive Cursor, 3D Tilt & Video Previews
---

<!-- خلفية التموجات الضوئية الحركية الانسيابية (Living Fluid Aurora) -->
<div class="cinematic-ambient-bg" aria-hidden="true">
  <div class="aurora-orb aurora-orb-1"></div>
  <div class="aurora-orb aurora-orb-2"></div>
  <div class="aurora-orb aurora-orb-3"></div>
</div>

<!-- شبكة الاستوديو التقنية الهندسية الدقيقة -->
<div class="studio-grid-overlay" aria-hidden="true"></div>

<!-- طبقة حبيبات ميكروسكوبية ناعمة لدمج الألوان السينمائية -->
<div class="film-grain fixed inset-0 pointer-events-none z-[999] select-none" aria-hidden="true"></div>

<!-- مؤشر الفأرة التفاعلي -->
<div
  id="cinema-cursor"
  class="fixed top-0 left-0 pointer-events-none z-[1000] -translate-x-1/2 -translate-y-1/2 opacity-0 hidden md:flex items-center justify-center rounded-full transition-[width,height,background-color,border-color,box-shadow] duration-200 ease-out select-none will-change-transform"
  style="width: 8px; height: 8px;"
>
  <span
    id="cursor-label"
    class="text-[8px] font-mono tracking-widest uppercase font-extrabold opacity-0 transition-opacity duration-150 pointer-events-none"
  ></span>
</div>

<style is:global>
  :root {
    --aw-color-accent: rgb(2 132 199);
  }
  html.dark {
    --aw-color-accent: rgb(56 189 248);
  }
  .text-accent {
    color: rgb(2 132 199) !important;
  }
  html.dark .text-accent {
    color: rgb(56 189 248) !important;
  }

  /* 1. خلفية التموجات الحية المتحركة (Living Aurora Mesh) */
  .cinematic-ambient-bg {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -20;
    overflow: hidden;
    background-color: #f6fafc;
    transition: background-color 0.6s ease;
  }
  html.dark .cinematic-ambient-bg {
    background-color: #06080e;
  }

  .aurora-orb {
    position: absolute;
    border-radius: 9999px;
    filter: blur(85px);
    will-change: transform;
    pointer-events: none;
  }

  /* Orb 1: Cyan / Electric Sky (أعلى اليمين) */
  .aurora-orb-1 {
    top: -15%;
    right: -10%;
    width: 65vw;
    height: 65vw;
    max-width: 900px;
    max-height: 900px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.42) 0%, rgba(14, 165, 233, 0.18) 45%, transparent 70%);
    animation: floatOrb1 22s ease-in-out infinite alternate;
  }
  html:not(.dark) .aurora-orb-1 {
    background: radial-gradient(circle, rgba(56, 189, 248, 0.32) 0%, rgba(186, 230, 253, 0.45) 50%, transparent 70%);
  }

  /* Orb 2: Deep Oceanic Cobalt (أسفل اليسار) */
  .aurora-orb-2 {
    bottom: -15%;
    left: -10%;
    width: 70vw;
    height: 70vw;
    max-width: 950px;
    max-height: 950px;
    background: radial-gradient(circle, rgba(2, 132, 199, 0.38) 0%, rgba(3, 105, 161, 0.15) 50%, transparent 70%);
    animation: floatOrb2 26s ease-in-out infinite alternate;
  }
  html:not(.dark) .aurora-orb-2 {
    background: radial-gradient(circle, rgba(14, 165, 233, 0.22) 0%, rgba(224, 242, 254, 0.55) 50%, transparent 70%);
  }

  /* Orb 3: Violet / Neon Indigo Accent (منتصف الشاشة) */
  .aurora-orb-3 {
    top: 30%;
    left: 20%;
    width: 55vw;
    height: 55vw;
    max-width: 750px;
    max-height: 750px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.22) 0%, rgba(56, 189, 248, 0.08) 50%, transparent 70%);
    animation: floatOrb3 24s ease-in-out infinite alternate;
  }
  html:not(.dark) .aurora-orb-3 {
    background: radial-gradient(circle, rgba(147, 197, 253, 0.28) 0%, rgba(199, 210, 254, 0.35) 50%, transparent 70%);
  }

  @keyframes floatOrb1 {
    0% {
      transform: translate3d(0, 0, 0) scale(1) rotate(0deg);
    }
    50% {
      transform: translate3d(-14vw, 10vh, 0) scale(1.15) rotate(40deg);
    }
    100% {
      transform: translate3d(8vw, 16vh, 0) scale(0.92) rotate(80deg);
    }
  }

  @keyframes floatOrb2 {
    0% {
      transform: translate3d(0, 0, 0) scale(1) rotate(0deg);
    }
    50% {
      transform: translate3d(16vw, -12vh, 0) scale(1.2) rotate(-40deg);
    }
    100% {
      transform: translate3d(4vw, -20vh, 0) scale(0.9) rotate(-75deg);
    }
  }

  @keyframes floatOrb3 {
    0% {
      transform: translate3d(0, 0, 0) scale(0.95);
    }
    50% {
      transform: translate3d(-10vw, -12vh, 0) scale(1.2);
    }
    100% {
      transform: translate3d(12vw, 10vh, 0) scale(1.05);
    }
  }

  /* 2. شبكة الاستوديو الهندسية (Blueprint Grid) */
  .studio-grid-overlay {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -18;
    background-image: radial-gradient(rgba(14, 165, 233, 0.16) 1px, transparent 1px);
    background-size: 30px 30px;
    mask-image: radial-gradient(ellipse 85% 75% at 50% 35%, black 45%, transparent 95%);
    -webkit-mask-image: radial-gradient(ellipse 85% 75% at 50% 35%, black 45%, transparent 95%);
    opacity: 0.65;
  }
  html:not(.dark) .studio-grid-overlay {
    background-image: radial-gradient(rgba(2, 132, 199, 0.08) 1px, transparent 1px);
    opacity: 0.5;
  }

  /* جعل خلفية الصفحة شفافة لتنساب التموجات تحت كل الأقسام */
  body {
    background-color: transparent !important;
    background-image: none !important;
  }

  /* حبيبات الفيلم الدقيقة */
  .film-grain {
    opacity: 0.022;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 128 128' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='f'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.6' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23f)'/%3E%3C/svg%3E");
    background-repeat: repeat;
  }
</style>

<script>
  function initCinematicFeatures() {
    if (window.matchMedia('(pointer: coarse)').matches) return;

    // 1. Custom Adaptive Cursor
    const cursorEl = document.getElementById('cinema-cursor');
    const labelEl = document.getElementById('cursor-label');

    if (cursorEl && labelEl) {
      const cursor: HTMLElement = cursorEl;
      const label: HTMLElement = labelEl;

      let mouseX = -100;
      let mouseY = -100;
      let currentX = -100;
      let currentY = -100;
      let isHoveringCard = false;
      let isVisible = false;

      const isDark = () => document.documentElement.classList.contains('dark');

      window.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
        if (!isVisible) {
          isVisible = true;
          cursor.style.opacity = '1';
        }
      });

      document.addEventListener('mouseleave', () => {
        isVisible = false;
        cursor.style.opacity = '0';
      });

      function render() {
        currentX += (mouseX - currentX) * 0.22;
        currentY += (mouseY - currentY) * 0.22;
        cursor.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) translate(-50%, -50%)`;
        requestAnimationFrame(render);
      }
      requestAnimationFrame(render);

      function resetCursor() {
        cursor.style.width = '7px';
        cursor.style.height = '7px';
        cursor.style.backgroundColor = isDark() ? 'rgba(56, 189, 248, 0.95)' : 'rgba(2, 132, 199, 0.9)';
        cursor.style.border = 'none';
        cursor.style.boxShadow = isDark() ? '0 0 8px rgba(56, 189, 248, 0.6)' : 'none';
      }

      const projectCards = document.querySelectorAll('#selected a, a[href*="/work/"], .project-card');

      projectCards.forEach((card) => {
        card.addEventListener('mouseenter', () => {
          isHoveringCard = true;
          cursor.style.width = '44px';
          cursor.style.height = '44px';
          if (isDark()) {
            cursor.style.backgroundColor = '#ffffff';
            label.style.color = '#000000';
            cursor.style.boxShadow = '0 0 18px rgba(56, 189, 248, 0.4)';
          } else {
            cursor.style.backgroundColor = '#0369a1';
            label.style.color = '#ffffff';
            cursor.style.boxShadow = '0 0 14px rgba(2, 132, 199, 0.25)';
          }
          label.textContent = 'VIEW';
          label.style.opacity = '1';
        });

        card.addEventListener('mouseleave', () => {
          isHoveringCard = false;
          label.style.opacity = '0';
          resetCursor();
        });
      });

      const standardLinks = document.querySelectorAll('header a, footer a, button, .btn');
      standardLinks.forEach((link) => {
        link.addEventListener('mouseenter', () => {
          if (isHoveringCard) return;
          cursor.style.width = '20px';
          cursor.style.height = '20px';
          cursor.style.backgroundColor = isDark() ? 'rgba(56, 189, 248, 0.2)' : 'rgba(2, 132, 199, 0.12)';
          cursor.style.border = isDark() ? '1px solid rgba(56, 189, 248, 0.5)' : '1px solid rgba(2, 132, 199, 0.35)';
        });

        link.addEventListener('mouseleave', () => {
          if (isHoveringCard) return;
          resetCursor();
        });
      });

      resetCursor();
    }

    // 2. 3D Perspective Tilt on Bento & Portfolio Cards
    const tiltCards = document.querySelectorAll<HTMLElement>('#selected a, .project-card');
    tiltCards.forEach((card) => {
      let rect: DOMRect | null = null;

      const handleMouseEnter = () => {
        rect = card.getBoundingClientRect();
        card.style.transition = 'transform 0.15s ease-out, border-color 0.3s ease, box-shadow 0.3s ease';
      };

      const handleMouseMove = (e: MouseEvent) => {
        if (!rect) rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const xNorm = (x / rect.width - 0.5) * 2;
        const yNorm = (y / rect.height - 0.5) * 2;
        card.style.transform = `perspective(1000px) rotateX(${-yNorm * 4}deg) rotateY(${xNorm * 4}deg) translateY(-2px)`;
      };

      const handleMouseLeave = () => {
        rect = null;
        card.style.transition = 'transform 0.5s ease-out, border-color 0.3s ease, box-shadow 0.3s ease';
        card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0)';
      };

      card.addEventListener('mouseenter', handleMouseEnter);
      card.addEventListener('mousemove', handleMouseMove);
      card.addEventListener('mouseleave', handleMouseLeave);
    });

    // 3. Smart Hover Video Previews
    const hoverContainers = document.querySelectorAll<HTMLElement>('[data-hover-video-container]');
    hoverContainers.forEach((container) => {
      const video = container.querySelector<HTMLVideoElement>('video');
      if (!video) return;

      container.addEventListener('mouseenter', () => {
        video.currentTime = 0;
        video.play().catch(() => {});
      });

      container.addEventListener('mouseleave', () => {
        video.pause();
      });
    });
  }

  initCinematicFeatures();
  document.addEventListener('astro:page-load', initCinematicFeatures);
</script>
