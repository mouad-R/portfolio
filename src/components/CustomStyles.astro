---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
---

<style is:inline>
  :root,
  .dark {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(14 165 233);
    --aw-color-secondary: rgb(2 132 199);
    --aw-color-accent: rgb(99 102 241);

    --aw-color-text-heading: rgb(250 250 250);
    --aw-color-text-default: rgb(228 228 231);
    --aw-color-text-muted: rgb(161 161 170);
    --aw-color-bg-page: rgb(9 10 13);
    --aw-color-bg-page-dark: rgb(9 10 13);

    ::selection {
      background-color: rgb(14 165 233 / 35%);
      color: rgb(255 255 255);
    }
  }
</style>
