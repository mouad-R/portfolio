---
// Permanent dark mode configuration
---

<script is:inline>
  function enforceDarkMode() {
    document.documentElement.classList.add('dark');
    document.documentElement.classList.remove('light');
    localStorage.setItem('theme', 'dark');
  }

  enforceDarkMode();
  document.addEventListener('astro:after-swap', enforceDarkMode);
  document.addEventListener('astro:page-load', enforceDarkMode);
</script>
