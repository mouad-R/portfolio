---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import { projects, type Project } from '~/data/projects';
import { getEmbedUrl } from '~/utils/media';

export function getStaticPaths() {
  return projects.map((project, index) => {
    const prevProject = index > 0 ? projects[index - 1] : projects[projects.length - 1];
    const nextProject = index < projects.length - 1 ? projects[index + 1] : projects[0];

    return {
      params: { slug: project.slug },
      props: { project, prevProject, nextProject },
    };
  });
}

interface Props {
  project: Project;
  prevProject: Project;
  nextProject: Project;
}

const { project, prevProject, nextProject } = Astro.props;

const metadata = {
  title: `${project.title} — Mouad Rouini`,
  description: project.description,
};
---

<Layout metadata={metadata}>
  <article class="max-w-5xl mx-auto px-4 sm:px-6 pt-16 pb-28">
    <!-- Breadcrumb / Back Link -->
    <div class="mb-10">
      <a
        href="/work"
        class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-neutral-500 dark:text-neutral-400 hover:text-sky-600 dark:hover:text-sky-400 transition-colors"
      >
        <span class="rtl:rotate-180">←</span>
        <span data-i18n="work.backToAll">Back to All Works</span>
      </a>
    </div>

    <!-- Project Header -->
    <header class="mb-14 border-b border-neutral-200 dark:border-neutral-800 pb-10">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-sky-300/40 bg-white/70 dark:border-white/10 dark:bg-neutral-900/60 backdrop-blur-md mb-4 shadow-sm"
      >
        <span class="text-[11px] font-mono text-sky-600 dark:text-sky-400 uppercase tracking-widest font-semibold">
          {project.category}
        </span>
      </div>

      <h1 class="text-4xl md:text-6xl font-bold text-neutral-900 dark:text-white tracking-tight mt-2 mb-6">
        {project.title}
      </h1>

      <div
        class="grid grid-cols-2 sm:grid-cols-4 gap-6 pt-6 border-t border-neutral-200 dark:border-neutral-900 text-xs font-mono"
      >
        <div>
          <span class="text-neutral-500 dark:text-neutral-400 block uppercase" data-i18n="work.role">Role</span>
          <span class="text-neutral-900 dark:text-neutral-100 mt-1 block font-semibold">{project.role}</span>
        </div>
        <div>
          <span class="text-neutral-500 dark:text-neutral-400 block uppercase" data-i18n="work.year">Year</span>
          <span class="text-neutral-900 dark:text-neutral-100 mt-1 block font-semibold">{project.year}</span>
        </div>
        <div class="col-span-2">
          <span class="text-neutral-500 dark:text-neutral-400 block uppercase" data-i18n="work.specs"
            >Technical Specs</span
          >
          <span class="text-neutral-900 dark:text-neutral-100 mt-1 block font-semibold">{project.specs}</span>
        </div>
      </div>
    </header>

    <!-- Overview Text -->
    <section class="max-w-3xl mb-16 text-neutral-700 dark:text-neutral-300 text-lg leading-relaxed font-normal">
      <p>{project.description}</p>
    </section>

    <!-- Project Media Showcase (Configurable Gap & Custom Spacers) -->
    <section
      class:list={[
        project.mediaGap === 'none' && 'space-y-0',
        project.mediaGap === 'sm' && 'space-y-4 sm:space-y-6',
        project.mediaGap === 'md' && 'space-y-8 sm:space-y-12',
        project.mediaGap === 'lg' && 'space-y-12 sm:space-y-16',
        !project.mediaGap && 'space-y-0',
      ]}
    >
      {
        project.media.map((item) =>
          item.type === 'spacer' ? (
            <div
              class:list={[
                item.size === 'sm' && 'h-6 sm:h-8',
                item.size === 'md' && 'h-12 sm:h-16',
                item.size === 'lg' && 'h-20 sm:h-28',
                item.size === 'xl' && 'h-32 sm:h-44',
                !item.size && 'h-12 sm:h-16',
                'w-full transition-colors',
              ]}
              style={
                item.bgColor && item.bgColor !== 'transparent'
                  ? `background-color: ${item.bgColor};`
                  : 'background-color: transparent;'
              }
              aria-hidden="true"
            />
          ) : (
            <div
              class:list={[
                'w-full overflow-hidden bg-neutral-950 shadow-2xl border border-neutral-800',
                project.mediaGap === 'none' || !project.mediaGap
                  ? 'rounded-none first:rounded-t-2xl last:rounded-b-2xl'
                  : 'rounded-2xl',
              ]}
            >
              {item.type === 'youtube' && item.src && (
                <div class="relative w-full aspect-video bg-black overflow-hidden">
                  <iframe
                    class="w-full h-full"
                    src={getEmbedUrl(item.src)}
                    title={project.title}
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen
                    loading="lazy"
                  />
                </div>
              )}

              {item.type === 'video' && item.src && (
                <div class="relative w-full bg-neutral-950 overflow-hidden flex items-center justify-center">
                  <video
                    autoplay
                    loop
                    muted
                    playsinline
                    controls
                    preload="metadata"
                    class="smart-video w-full h-auto max-h-[88vh] object-contain mx-auto"
                  >
                    <source src={item.src} type={item.src.endsWith('.webm') ? 'video/webm' : 'video/mp4'} />
                    <source src={item.src} />
                    Your browser does not support playing this video.
                  </video>
                </div>
              )}

              {item.type === 'image' && item.src && (
                <div class="relative w-full overflow-hidden bg-neutral-950">
                  <img
                    src={item.src}
                    alt={item.caption || project.title}
                    class="w-full h-auto object-cover"
                    loading="lazy"
                  />
                  {item.caption && (
                    <div class="p-4 bg-neutral-950/90 border-t border-white/10 text-xs font-mono text-neutral-400">
                      {item.caption}
                    </div>
                  )}
                </div>
              )}
            </div>
          )
        )
      }
    </section>

    <!-- Next / Previous Project Navigation -->
    <nav class="mt-24 pt-12 border-t border-neutral-200 dark:border-neutral-800 grid grid-cols-1 sm:grid-cols-2 gap-6">
      <a
        href={`/work/${prevProject.slug}`}
        class="group p-6 rounded-2xl border border-neutral-200 dark:border-white/10 bg-white/60 dark:bg-neutral-900/40 hover:border-sky-500/50 transition-all flex flex-col justify-between"
      >
        <span
          class="text-xs font-mono text-neutral-500 dark:text-neutral-400 uppercase tracking-wider mb-2"
          data-i18n="work.prevProject"
        >
          ← Previous Project
        </span>
        <span
          class="text-xl font-bold text-neutral-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors"
        >
          {prevProject.title}
        </span>
      </a>

      <a
        href={`/work/${nextProject.slug}`}
        class="group p-6 rounded-2xl border border-neutral-200 dark:border-white/10 bg-white/60 dark:bg-neutral-900/40 hover:border-sky-500/50 transition-all flex flex-col justify-between sm:items-end text-left sm:text-right"
      >
        <span
          class="text-xs font-mono text-neutral-500 dark:text-neutral-400 uppercase tracking-wider mb-2"
          data-i18n="work.nextProject"
        >
          Next Project →
        </span>
        <span
          class="text-xl font-bold text-neutral-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors"
        >
          {nextProject.title}
        </span>
      </a>
    </nav>
  </article>
</Layout>

<script>
  function initSmartVideos() {
    const videos = document.querySelectorAll<HTMLVideoElement>('video.smart-video');
    if (!videos.length) return;

    videos.forEach((video) => {
      video.muted = true;
      video.defaultMuted = true;
      video.play().catch(() => {});
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            if (video.paused && video.muted) {
              video.play().catch(() => {});
            }
          } else {
            if (video.muted) {
              video.pause();
            }
          }
        });
      },
      { threshold: 0.15 }
    );

    videos.forEach((video) => observer.observe(video));
  }

  initSmartVideos();
  document.addEventListener('astro:page-load', initSmartVideos);
</script>
