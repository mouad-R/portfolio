---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About — Mouad Rouini | Senior Motion Designer & Visual Director',
  description:
    'Learn about Mouad Rouini — a Senior Motion Designer & Visual Director based in Algiers, specialized in broadcast identities, 3D CGI, and cinematic post-production.',
};

const timeline = [
  {
    year: '2019',
    title: 'Started Creative Journey',
    desc: 'Began exploring motion design and video editing, building a foundation in After Effects and Premiere Pro.',
  },
  {
    year: '2021',
    title: 'First Commercial Projects',
    desc: 'Delivered first broadcast packages and kinetic branding projects for local agencies and startups.',
  },
  {
    year: '2023',
    title: 'Expanded into 3D & CGI',
    desc: 'Integrated Cinema 4D, Octane Render, and Redshift into the pipeline — specializing in photorealistic product visualization.',
  },
  {
    year: '2025',
    title: 'Full-Pipeline Visual Direction',
    desc: 'Now offering end-to-end creative direction: concept → storyboard → production → color grading → final delivery.',
  },
];

const tools = [
  { category: 'Motion & Animation', items: ['After Effects', 'Cinema 4D', 'Lottie'] },
  { category: '3D & Rendering', items: ['Octane Render', 'Redshift', 'Blender'] },
  { category: 'Color & Edit', items: ['DaVinci Resolve', 'Premiere Pro', 'ACES Pipeline'] },
  { category: 'Design & Prototype', items: ['Figma', 'Illustrator', 'Photoshop'] },
];
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <section class="relative pt-20 pb-16 md:pt-32 md:pb-20 max-w-5xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-12 items-start">
      <!-- Text -->
      <div class="md:col-span-3">
        <span class="text-xs font-mono uppercase tracking-widest text-sky-600 dark:text-sky-400 block mb-4 font-bold"
          >About Me</span
        >
        <h1
          class="text-3xl sm:text-4xl md:text-5xl font-bold text-neutral-900 dark:text-white tracking-tight leading-tight mb-6"
        >
          Creative problem‑solver with a passion for motion&nbsp;&&nbsp;light.
        </h1>
        <div class="space-y-4 text-neutral-600 dark:text-neutral-300 text-sm md:text-base leading-relaxed">
          <p>
            I'm <strong class="text-neutral-900 dark:text-white">Mouad Rouini</strong> — a Senior Motion Designer & Visual
            Director based in Algiers, Algeria. I specialize in crafting rhythm‑driven motion graphics, broadcast identities,
            and high‑fidelity CGI visuals that bridge dynamic 2D/3D animation with cinematic post‑production.
          </p>
          <p>
            My work spans commercial title sequences, kinetic typography systems, photorealistic product renders, and
            full‑pipeline color grading — always with an obsessive focus on pacing, detail, and visual storytelling.
          </p>
          <p>
            I believe great motion design is more than movement — it's rhythm, emotion, and precision working together
            to make brands unforgettable.
          </p>
        </div>

        <div class="flex items-center gap-4 mt-8">
          <a
            href="/contact"
            class="px-6 py-3 rounded-xl bg-neutral-900 text-white dark:bg-white dark:text-black font-semibold text-xs tracking-wider uppercase hover:opacity-90 transition-all shadow-md"
          >
            Work With Me →
          </a>
          <a
            href="/#selected"
            class="px-6 py-3 rounded-xl border border-neutral-300/80 dark:border-white/15 text-neutral-900 dark:text-white font-medium text-xs tracking-wider uppercase hover:border-neutral-500 transition-all"
          >
            View Portfolio ↓
          </a>
        </div>
      </div>

      <!-- Photo placeholder -->
      <div class="md:col-span-2">
        <div
          class="aspect-[3/4] rounded-2xl overflow-hidden border border-neutral-200 dark:border-white/10 bg-neutral-100 dark:bg-neutral-900 flex items-center justify-center"
        >
          <div class="text-center px-6">
            <div
              class="w-20 h-20 rounded-full bg-neutral-200 dark:bg-neutral-800 mx-auto mb-4 flex items-center justify-center"
            >
              <span class="text-2xl">MR</span>
            </div>
            <p class="text-xs text-neutral-500 font-mono uppercase tracking-wider">Professional Photo</p>
            <p class="text-[10px] text-neutral-400 mt-1">Replace with your headshot</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 border-t border-neutral-200 dark:border-white/10">
    <div class="mb-10">
      <span class="text-xs font-mono uppercase tracking-widest text-sky-600 dark:text-sky-400 block mb-1.5 font-bold"
        >Journey</span
      >
      <h2 class="text-2xl md:text-3xl font-bold text-neutral-900 dark:text-white tracking-tight">Career Timeline</h2>
    </div>

    <div class="relative">
      <!-- Vertical line -->
      <div class="absolute left-[7px] top-2 bottom-2 w-px bg-neutral-200 dark:bg-neutral-800"></div>

      <div class="space-y-10">
        {
          timeline.map((item, i) => (
            <div class="relative pl-8 intersect-once intersect:opacity-100 intersect:translate-y-0 opacity-0 translate-y-6 duration-700">
              <div
                class:list={[
                  'absolute left-0 top-1.5 w-[15px] h-[15px] rounded-full border-2',
                  i === timeline.length - 1
                    ? 'border-sky-500 bg-sky-500/20'
                    : 'border-neutral-400 dark:border-neutral-600 bg-page',
                ]}
              />
              <span class="text-xs font-mono text-sky-600 dark:text-sky-400 font-bold uppercase tracking-wider block mb-1">
                {item.year}
              </span>
              <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-1">{item.title}</h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Tools & Stack -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 border-t border-neutral-200 dark:border-white/10">
    <div class="mb-10">
      <span class="text-xs font-mono uppercase tracking-widest text-sky-600 dark:text-sky-400 block mb-1.5 font-bold"
        >Stack</span
      >
      <h2 class="text-2xl md:text-3xl font-bold text-neutral-900 dark:text-white tracking-tight">
        Tools & Technologies
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        tools.map((group) => (
          <div class="p-6 rounded-2xl bg-white/60 dark:bg-neutral-900/60 backdrop-blur-xl border border-neutral-200 dark:border-white/10 intersect-once intersect:opacity-100 intersect:translate-y-0 opacity-0 translate-y-6 duration-700">
            <h3 class="text-xs font-mono uppercase tracking-widest text-sky-600 dark:text-sky-400 font-bold mb-4">
              {group.category}
            </h3>
            <ul class="space-y-2">
              {group.items.map((tool) => (
                <li class="text-sm text-neutral-700 dark:text-neutral-300 font-medium">{tool}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
    <div
      class="rounded-2xl p-8 md:p-12 bg-white/60 dark:bg-neutral-900/50 backdrop-blur-xl border border-sky-200/60 dark:border-white/10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 shadow-lg intersect-once intersect:opacity-100 intersect:translate-y-0 opacity-0 translate-y-6 duration-700"
    >
      <div class="max-w-xl">
        <h2 class="text-2xl md:text-3xl font-bold text-neutral-900 dark:text-white tracking-tight mb-2">
          Interested in working together?
        </h2>
        <p class="text-neutral-600 dark:text-neutral-300 text-sm">
          Open for commercial direction, motion commissions, and full‑pipeline visual production.
        </p>
      </div>
      <a
        href="/contact"
        class="flex-shrink-0 px-7 py-3.5 rounded-xl bg-neutral-900 text-white dark:bg-white dark:text-black font-semibold text-xs tracking-wider uppercase hover:opacity-90 transition-all shadow-md"
      >
        Get in Touch ↗
      </a>
    </div>
  </section>
</Layout>
