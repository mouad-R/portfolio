---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Mouad Rouini — Senior Motion Designer & Visual Director',
  description: 'Specialized in rhythm-driven motion design, broadcast identities, and high-fidelity visual storytelling.',
};

const disciplines = [
  {
    num: '01',
    title: 'Motion Design',
    category: 'Kinetic & Animation',
    specs: '60 FPS · AE / Cinema 4D · Kinetic Systems',
    href: '/motion',
    image: 'https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=1200&q=80',
    gridSpan: 'md:col-span-2 lg:col-span-2 aspect-[21/9] sm:aspect-[2.35/1]',
  },
  {
    num: '02',
    title: 'Cinematography',
    category: 'Film Direction & Color',
    specs: 'ARRI / RED · 2.39:1 · DaVinci Wide Gamut',
    href: '/cinematography',
    image: 'https://images.unsplash.com/photo-1485846234645-a62644f84728?auto=format&fit=crop&w=800&q=80',
    gridSpan: 'md:col-span-1 lg:col-span-1 aspect-[16/10]',
  },
  {
    num: '03',
    title: '3D Art & CGI',
    category: 'Lookdev & Rendering',
    specs: 'Cinema 4D · Octane / Redshift · Shading',
    href: '/3d',
    image: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=800&q=80',
    gridSpan: 'md:col-span-1 lg:col-span-1 aspect-[16/10]',
  },
  {
    num: '04',
    title: 'Graphic & Brand',
    category: 'Identity & Packaging',
    specs: 'Brand Systems · Luxury Mockups · Print Specs',
    href: '/graphic-design',
    image: 'https://images.unsplash.com/photo-1626785774573-4b799315345d?auto=format&fit=crop&w=800&q=80',
    gridSpan: 'md:col-span-1 lg:col-span-1 aspect-[16/10]',
  },
  {
    num: '05',
    title: 'UI / UX Design',
    category: 'Product Systems & Apps',
    specs: 'Design Systems · Figma · Interactive Prototypes',
    href: '/ui-ux',
    image: 'https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?auto=format&fit=crop&w=800&q=80',
    gridSpan: 'md:col-span-1 lg:col-span-1 aspect-[16/10]',
  },
];

const services = [
  {
    step: '01',
    title: 'Motion Design & Kinetic Branding',
    desc: 'Bespoke broadcast packages, commercial title sequences, kinetic typography systems, and high-energy promotional films crafted with rhythm and dynamic pacing.',
    tags: ['Broadcast Packages', 'Kinetic Type', 'After Effects', '60 FPS'],
  },
  {
    step: '02',
    title: 'Film Direction & Color Grading',
    desc: 'High-end visual storytelling, lighting architecture, camera direction, and technical ACES / DaVinci Resolve color pipelines for commercial and narrative productions.',
    tags: ['Camera Direction', 'DaVinci Resolve', 'ACES Pipeline', 'Lighting Setups'],
  },
  {
    step: '03',
    title: '3D CGI & Look Development',
    desc: 'Photorealistic product simulations, complex procedural shading, hard-surface modeling, and lookdev lighting built for luxury commercials and brand visuals.',
    tags: ['Cinema 4D', 'Octane / Redshift', 'Procedural Shading', 'Lookdev'],
  },
];
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <section class="relative pt-20 pb-16 md:pt-32 md:pb-24 max-w-6xl mx-auto px-4 sm:px-6">
    <div class="max-w-4xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-sky-300/40 bg-white/70 dark:border-white/10 dark:bg-neutral-900/60 backdrop-blur-md mb-8 shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-[11px] font-mono text-neutral-800 dark:text-neutral-300 uppercase tracking-widest font-medium">
          Available for Direction & Commercial Commissions
        </span>
      </div>

      <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold text-neutral-900 dark:text-white tracking-tight leading-[1.08] mb-6 transition-colors">
        Senior Motion Designer & Visual Director.
      </h1>

      <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl leading-relaxed mb-8 font-normal transition-colors">
        Specialized in rhythm-driven motion design, broadcast identities, and high-fidelity visual storytelling — bridging dynamic 2D/3D animation with cinematic post-production.
      </p>

      <div class="flex items-center gap-4">
        <a
          href="#selected"
          class="px-6 py-3 rounded-xl bg-neutral-900 text-white dark:bg-white dark:text-black font-semibold text-xs tracking-wider uppercase hover:opacity-90 transition-all shadow-md"
        >
          View Motion & Works ↓
        </a>
        <a
          href="/contact"
          class="px-6 py-3 rounded-xl border border-neutral-300/80 bg-white/70 dark:border-white/15 dark:bg-neutral-900/50 backdrop-blur-md text-neutral-900 dark:text-white font-medium text-xs tracking-wider uppercase hover:border-neutral-500 transition-all"
        >
          Initiate Collaboration →
        </a>
      </div>
    </div>
  </section>

  <!-- Selected Works Bento Grid -->
  <section id="selected" class="max-w-6xl mx-auto px-4 sm:px-6 py-16 border-t border-sky-200/50 dark:border-white/10">
    <div class="flex items-end justify-between mb-10">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-sky-600 dark:text-sky-400 block mb-1.5 font-bold">Index</span>
        <h2 class="text-2xl md:text-4xl font-bold text-neutral-900 dark:text-white tracking-tight">
          Selected Disciplines
        </h2>
      </div>
      <span class="text-xs font-mono text-neutral-500 hidden sm:block">
        [ 05 DISCIPLINES // MOTION-FIRST ]
      </span>
    </div>

    <!-- The Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {disciplines.map((item) => (
        <a
          href={item.href}
          class={`group relative overflow-hidden rounded-2xl border border-neutral-200/80 dark:border-white/10 bg-neutral-950 flex flex-col justify-between p-6 transition-all duration-500 hover:border-sky-400/80 dark:hover:border-sky-400/80 shadow-md hover:shadow-xl ${item.gridSpan}`}
        >
          <div class="absolute inset-0 z-0 overflow-hidden">
            <img
              src={item.image}
              alt={item.title}
              class="w-full h-full object-cover opacity-50 group-hover:opacity-75 group-hover:scale-105 transition-all duration-700 ease-out"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-black/30 group-hover:from-black/80 transition-colors duration-500"></div>
          </div>

          <div class="relative z-10 flex items-center justify-between">
            <div class="inline-flex items-center gap-2">
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/10 text-white/90 backdrop-blur-md border border-white/15 uppercase tracking-wider font-semibold">
                {item.num}
              </span>
              <span class="text-[11px] font-mono uppercase tracking-wider text-neutral-300 font-medium">
                {item.category}
              </span>
            </div>

            <div class="w-8 h-8 rounded-full border border-white/20 bg-white/10 backdrop-blur-md flex items-center justify-center text-white text-xs group-hover:bg-white group-hover:text-black group-hover:border-white transition-all duration-300">
              ↗
            </div>
          </div>

          <div class="relative z-10 pt-8">
            <h3 class="text-xl sm:text-2xl md:text-3xl font-bold text-white tracking-tight mb-1.5 group-hover:text-sky-300 transition-colors duration-300">
              {item.title}
            </h3>
            <p class="text-[11px] font-mono text-neutral-300 tracking-wide uppercase">
              {item.specs}
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- How I Can Help Section -->
  <section id="services" class="max-w-6xl mx-auto px-4 sm:px-6 py-20 border-t border-sky-200/50 dark:border-white/10">
    <div class="flex items-end justify-between mb-12">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-sky-600 dark:text-sky-400 block mb-1.5 font-bold">Capabilities</span>
        <h2 class="text-2xl md:text-4xl font-bold text-neutral-900 dark:text-white tracking-tight">
          How I Can Help
        </h2>
      </div>
      <span class="text-xs font-mono text-neutral-500 hidden sm:block">
        [ END-TO-END VISUAL PIPELINE ]
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {services.map((srv) => (
        <div class="relative p-7 rounded-2xl bg-white/60 dark:bg-[#070d1d]/60 backdrop-blur-xl border border-sky-100/80 dark:border-white/10 shadow-sm flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono text-sky-600 dark:text-sky-400 font-bold uppercase tracking-wider block mb-4">
              // {srv.step}
            </span>
            <h3 class="text-xl font-bold text-neutral-900 dark:text-white tracking-tight mb-3">
              {srv.title}
            </h3>
            <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed mb-6 font-normal">
              {srv.desc}
            </p>
          </div>

          <div class="flex flex-wrap gap-1.5 pt-4 border-t border-neutral-200/60 dark:border-white/10">
            {srv.tags.map((tag) => (
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-sky-50 text-sky-800 dark:bg-white/5 dark:text-neutral-300 border border-sky-100 dark:border-white/10">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
    <div class="rounded-2xl p-8 md:p-12 bg-white/60 dark:bg-neutral-900/50 backdrop-blur-xl border border-sky-200/60 dark:border-white/10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 shadow-lg">
      <div class="max-w-xl">
        <h2 class="text-2xl md:text-3xl font-bold text-neutral-900 dark:text-white tracking-tight mb-2">
          Have a production or kinetic campaign in development?
        </h2>
        <p class="text-neutral-600 dark:text-neutral-300 text-sm">
          Open for select commercial direction, title sequences, and full-pipeline motion commissions.
        </p>
      </div>
      <a
        href="/contact"
        class="flex-shrink-0 px-7 py-3.5 rounded-xl bg-neutral-900 text-white dark:bg-white dark:text-black font-semibold text-xs tracking-wider uppercase hover:opacity-90 transition-all shadow-md"
      >
        Get in Touch ↗
      </a>
    </div>
  </section>
</Layout>
