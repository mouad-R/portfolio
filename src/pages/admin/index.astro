---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import { projects } from '~/data/projects';

const metadata = {
  title: 'Studio Admin — Projects & Media Manager | Mouad Rouini',
  robots: {
    index: false,
    follow: false,
  },
};
---

<Layout metadata={metadata}>
  <!-- Pass initial projects data safely to client -->
  <div id="initial-projects-data" data-projects={JSON.stringify(projects)} class="hidden"></div>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-24 pb-28 min-h-screen">
    <!-- Header -->
    <div
      class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-10 pb-6 border-b border-neutral-200 dark:border-white/10"
    >
      <div>
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-sky-300/40 bg-white/70 dark:border-white/10 dark:bg-neutral-900/60 backdrop-blur-md mb-2 shadow-sm"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span
            class="text-[10px] font-mono uppercase tracking-widest text-neutral-800 dark:text-neutral-300 font-semibold"
          >
            Studio Management Console
          </span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold text-neutral-900 dark:text-white tracking-tight">
          لوحة إدارة ومحرر الأعمال
        </h1>
      </div>

      <div class="flex items-center gap-3">
        <button
          type="button"
          id="btn-settings"
          class="px-4 py-2.5 rounded-xl border border-neutral-300 dark:border-white/15 bg-white/80 dark:bg-neutral-900/80 text-xs font-mono font-medium hover:border-neutral-500 transition-colors flex items-center gap-2 cursor-pointer"
        >
          <span>⚙️ إعدادات GitHub</span>
          <span id="github-badge" class="w-2 h-2 rounded-full bg-amber-500"></span>
        </button>

        <button
          type="button"
          id="btn-create-new"
          class="px-5 py-2.5 rounded-xl bg-neutral-900 text-white dark:bg-white dark:text-black text-xs font-mono font-semibold hover:opacity-90 transition-all shadow-md flex items-center gap-2 cursor-pointer"
        >
          <span>+ إضافة مشروع جديد</span>
        </button>
      </div>
    </div>

    <!-- GitHub Token Modal -->
    <div
      id="settings-modal"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300"
    >
      <div
        class="w-full max-w-md rounded-2xl bg-white dark:bg-neutral-900 p-6 border border-neutral-200 dark:border-white/10 shadow-2xl"
      >
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold text-neutral-900 dark:text-white">إعدادات الاتصال بـ GitHub</h2>
          <button
            type="button"
            id="close-settings"
            class="text-neutral-500 hover:text-black dark:hover:text-white text-sm cursor-pointer">✕</button
          >
        </div>
        <p class="text-xs text-neutral-600 dark:text-neutral-400 mb-4 leading-relaxed font-mono">
          لتتمكن من نشر وتحديث المشاريع ورفع الصور مباشرة إلى مستودعك، أدخل رمز GitHub Personal Access Token (PAT).
          يُحفظ الرمز في متصفحك فقط.
        </p>
        <div class="space-y-4">
          <div>
            <label class="block text-xs font-mono uppercase text-neutral-500 mb-1"
              >GitHub Personal Access Token (PAT)</label
            >
            <input
              type="password"
              id="input-github-token"
              placeholder="ghp_..."
              class="w-full px-3 py-2.5 rounded-xl text-xs font-mono bg-neutral-100 dark:bg-black border border-neutral-300 dark:border-white/10 text-neutral-900 dark:text-white focus:outline-none focus:border-sky-500"
            />
          </div>
          <button
            type="button"
            id="btn-save-token"
            class="w-full py-3 rounded-xl bg-sky-600 text-white font-mono text-xs font-semibold hover:bg-sky-500 transition-colors cursor-pointer"
          >
            حفظ الرمز وتفعيل النشر المباشر ✓
          </button>
        </div>
      </div>
    </div>

    <!-- VIEW 1: Projects Overview List -->
    <div id="view-projects-list" class="space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold text-neutral-900 dark:text-white font-mono">
          المشاريع المنشورة حالياً (<span id="count-projects">0</span>)
        </h2>
        <span class="text-xs font-mono text-neutral-500">انقر على أي مشروع لتعديل بياناته أو إعادة ترتيب وسائطه</span>
      </div>

      <div id="projects-table" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Rendered dynamically -->
      </div>
    </div>

    <!-- VIEW 2: Project Editor (Form + Mixed Batch Dropzone + Spacer Controls) -->
    <div id="view-project-editor" class="hidden space-y-10">
      <!-- Back / Nav -->
      <div class="flex items-center justify-between pb-4 border-b border-neutral-200 dark:border-white/10">
        <button
          type="button"
          id="btn-back-to-list"
          class="inline-flex items-center gap-2 text-xs font-mono text-neutral-500 hover:text-neutral-900 dark:hover:text-white transition-colors cursor-pointer"
        >
          <span>← العودة لقائمة المشاريع</span>
        </button>

        <span
          id="editor-mode-badge"
          class="text-xs font-mono px-3 py-1 rounded-full bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20 font-semibold"
        >
          محرر المشروع
        </span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- LEFT: Project Metadata & Settings (Col 5) -->
        <div
          class="lg:col-span-5 space-y-6 bg-white/70 dark:bg-neutral-900/60 p-6 sm:p-7 rounded-3xl border border-neutral-200 dark:border-white/10 backdrop-blur-xl"
        >
          <h2
            class="text-base font-bold text-neutral-900 dark:text-white font-mono pb-2 border-b border-neutral-200 dark:border-white/10"
          >
            1. معلومات وتفاصيل العمل
          </h2>

          <div class="space-y-5 text-xs font-mono">
            <!-- Title -->
            <div>
              <label class="block uppercase text-neutral-500 mb-1 font-semibold">عنوان المشروع (Title) *</label>
              <input
                type="text"
                id="form-title"
                placeholder="e.g. Kinetic Brand Identity"
                class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-100 dark:bg-neutral-950 border border-neutral-300 dark:border-white/10 text-neutral-900 dark:text-white text-sm focus:outline-none focus:border-sky-500"
              />
            </div>

            <!-- Slug & Year -->
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block uppercase text-neutral-500 mb-1">الرابط (Slug) *</label>
                <input
                  type="text"
                  id="form-slug"
                  placeholder="kinetic-brand"
                  class="w-full px-3 py-2 rounded-xl bg-neutral-100 dark:bg-neutral-950 border border-neutral-300 dark:border-white/10 text-neutral-900 dark:text-white text-xs focus:outline-none focus:border-sky-500"
                />
              </div>

              <div>
                <label class="block uppercase text-neutral-500 mb-1">السنة (Year)</label>
                <input
                  type="text"
                  id="form-year"
                  placeholder="2026"
                  class="w-full px-3 py-2 rounded-xl bg-neutral-100 dark:bg-neutral-950 border border-neutral-300 dark:border-white/10 text-neutral-900 dark:text-white text-xs focus:outline-none focus:border-sky-500"
                />
              </div>
            </div>

            <!-- Category with Custom Category Option -->
            <div>
              <div class="flex items-center justify-between mb-1">
                <label class="block uppercase text-neutral-500 font-semibold">التصنيف (Category)</label>
                <button
                  type="button"
                  id="btn-toggle-custom-category"
                  class="text-[11px] text-sky-600 dark:text-sky-400 hover:underline cursor-pointer"
                >
                  + تصنيف مخصص
                </button>
              </div>

              <select
                id="form-category-select"
                class="w-full px-3 py-2.5 rounded-xl bg-neutral-100 dark:bg-neutral-950 border border-neutral-300 dark:border-white/10 text-neutral-900 dark:text-white text-xs focus:outline-none focus:border-sky-500 cursor-pointer"
              >
                <option value="motion|Motion Design & Kinetic">Motion Design & Kinetic</option>
                <option value="3d|3D Art & CGI Lookdev">3D Art & CGI Lookdev</option>
                <option value="cinematography|Cinematography & Color Grade">Cinematography & Color Grade</option>
                <option value="brand|Brand Identity & Packaging">Brand Identity & Packaging</option>
                <option value="ui-ux|UI / UX Product Design">UI / UX Product Design</option>
                <option value="__custom__">+ إضافة تصنيف جديد...</option>
              </select>

              <div id="custom-category-box" class="hidden mt-2 flex items-center gap-2">
                <input
                  type="text"
                  id="form-custom-category-input"
                  placeholder="اكتب اسم التصنيف الجديد..."
                  class="flex-1 px-3 py-2 rounded-xl bg-neutral-100 dark:bg-neutral-950 border border-sky-500 text-neutral-900 dark:text-white text-xs"
                />
                <button
                  type="button"
                  id="btn-apply-custom-category"
                  class="px-3 py-2 rounded-xl bg-sky-600 text-white text-xs font-semibold hover:bg-sky-500 cursor-pointer"
                >
                  إضافة
                </button>
              </div>
            </div>

            <!-- Role -->
            <div>
              <label class="block uppercase text-neutral-500 mb-1">دورك في المشروع (Role)</label>
              <input
                type="text"
                id="form-role"
                placeholder="Senior Motion Designer & 3D Animator"
                class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-100 dark:bg-neutral-950 border border-neutral-300 dark:border-white/10 text-neutral-900 dark:text-white text-xs focus:outline-none focus:border-sky-500"
              />
            </div>

            <!-- Programs & Specs with Ready-Made Badges -->
            <div>
              <label class="block uppercase text-neutral-500 mb-1.5 font-semibold">
                البرامج والمواصفات الفنية (Specs)
              </label>

              <!-- Ready badges -->
              <div class="flex flex-wrap gap-1.5 mb-2.5" id="specs-badges-container">
                {
                  [
                    'After Effects',
                    'Cinema 4D',
                    'Octane Render',
                    'Redshift',
                    'Blender',
                    'DaVinci Resolve',
                    'ACES Color',
                    '60 FPS',
                    'Premiere Pro',
                    'Figma',
                    'Unreal Engine',
                    'Houdini',
                  ].map((badge) => (
                    <button
                      type="button"
                      data-badge={badge}
                      class="spec-badge-btn px-2.5 py-1 rounded-md bg-neutral-100 dark:bg-white/5 border border-neutral-200 dark:border-white/10 text-[11px] text-neutral-700 dark:text-neutral-300 hover:border-sky-500 transition-colors cursor-pointer"
                    >
                      + {badge}
                    </button>
                  ))
                }
              </div>

              <input
                type="text"
                id="form-specs"
                placeholder="After Effects · Cinema 4D · 60fps"
                class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-100 dark:bg-neutral-950 border border-neutral-300 dark:border-white/10 text-neutral-900 dark:text-white text-xs focus:outline-none focus:border-sky-500"
              />
            </div>

            <!-- Cover Thumbnail Dropzone -->
            <div>
              <label class="block uppercase text-neutral-500 mb-1.5 font-semibold">
                صورة الغلاف (Cover Thumbnail) *
              </label>
              <div
                id="dropzone-cover"
                class="relative p-4 rounded-2xl border-2 border-dashed border-neutral-300 dark:border-white/15 hover:border-sky-500 transition-colors bg-neutral-50 dark:bg-neutral-950/50 flex flex-col items-center justify-center text-center cursor-pointer min-h-[110px]"
              >
                <input type="file" id="input-cover-file" accept="image/*" class="hidden" />
                <div id="cover-preview-box" class="hidden w-full aspect-video rounded-xl overflow-hidden mb-2 relative">
                  <img id="cover-preview-img" src="" alt="Cover preview" class="w-full h-full object-cover" />
                  <button
                    type="button"
                    id="btn-remove-cover"
                    class="absolute top-2 right-2 px-2 py-1 rounded bg-black/80 text-white text-[10px] hover:bg-red-600"
                    >حذف</button
                  >
                </div>
                <div id="cover-placeholder" class="space-y-1">
                  <span class="text-xl">🖼️</span>
                  <p class="text-[11px] text-neutral-600 dark:text-neutral-300 font-medium">
                    اسحب صورة الغلاف وأفلتها هنا أو اضغط للاختيار
                  </p>
                </div>
              </div>
              <input
                type="text"
                id="form-thumbnail"
                placeholder="أو ضع رابط صورة خارجي (https://...)"
                class="mt-2 w-full px-3 py-1.5 rounded-lg bg-neutral-100 dark:bg-neutral-950 border border-neutral-300 dark:border-white/10 text-neutral-900 dark:text-white text-[11px]"
              />
            </div>

            <!-- Short Video Hover Preview Dropzone -->
            <div>
              <label class="block uppercase text-neutral-500 mb-1.5 font-semibold">
                معاينة فيديو قصيرة عند التمرير (اختياري)
              </label>
              <div
                id="dropzone-preview-video"
                class="relative p-4 rounded-2xl border-2 border-dashed border-neutral-300 dark:border-white/15 hover:border-sky-500 transition-colors bg-neutral-50 dark:bg-neutral-950/50 flex flex-col items-center justify-center text-center cursor-pointer min-h-[90px]"
              >
                <input type="file" id="input-preview-video-file" accept="video/*" class="hidden" />
                <div
                  id="preview-video-box"
                  class="hidden w-full aspect-video rounded-xl overflow-hidden mb-2 relative bg-black"
                >
                  <video id="preview-video-element" autoplay loop muted playsinline class="w-full h-full object-contain"
                  ></video>
                  <button
                    type="button"
                    id="btn-remove-preview-video"
                    class="absolute top-2 right-2 px-2 py-1 rounded bg-black/80 text-white text-[10px] hover:bg-red-600"
                    >حذف</button
                  >
                </div>
                <div id="preview-video-placeholder" class="space-y-1">
                  <span class="text-xl">🎬</span>
                  <p class="text-[11px] text-neutral-600 dark:text-neutral-300 font-medium">
                    اسحب مقطع فيديو قصير صامت (.webm / .mp4) أو اضغط للاختيار
                  </p>
                </div>
              </div>
              <input
                type="text"
                id="form-video-preview"
                placeholder="أو ضع مسار الفيديو (/projects/.../preview.webm)"
                class="mt-2 w-full px-3 py-1.5 rounded-lg bg-neutral-100 dark:bg-neutral-950 border border-neutral-300 dark:border-white/10 text-neutral-900 dark:text-white text-[11px]"
              />
            </div>

            <!-- Description -->
            <div>
              <label class="block uppercase text-neutral-500 mb-1 font-semibold">نبذة ووصف المشروع (Description)</label>
              <textarea
                id="form-description"
                rows="4"
                placeholder="اشرح هنا فكرة المشروع، التحديات الإبداعية، ونتائج العمل..."
                class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-100 dark:bg-neutral-950 border border-neutral-300 dark:border-white/10 text-neutral-900 dark:text-white text-xs focus:outline-none focus:border-sky-500"
              ></textarea>
            </div>
          </div>
        </div>

        <!-- RIGHT: Media Builder with Batch Dropzone & Drag/Drop Reordering (Col 7) -->
        <div class="lg:col-span-7 space-y-6">
          <div
            class="bg-white/70 dark:bg-neutral-900/60 p-6 sm:p-7 rounded-3xl border border-neutral-200 dark:border-white/10 backdrop-blur-xl"
          >
            <!-- Top Controls & Global Gap -->
            <div
              class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-neutral-200 dark:border-white/10"
            >
              <div>
                <h2 class="text-base font-bold text-neutral-900 dark:text-white font-mono">
                  2. محرر وترتيب وسائط المشروع
                </h2>
                <p class="text-xs text-neutral-500 font-mono mt-0.5">
                  رتب وسائطك بالسحب والإفلات، وتحكم بالفراغات بينها
                </p>
              </div>

              <!-- Global Gap Option -->
              <div class="flex items-center gap-2 text-xs font-mono">
                <span class="text-neutral-500">الفراغ العام:</span>
                <select
                  id="form-media-gap"
                  class="px-2.5 py-1.5 rounded-lg bg-neutral-100 dark:bg-neutral-800 border border-neutral-300 dark:border-white/10 text-neutral-900 dark:text-white text-xs cursor-pointer"
                >
                  <option value="none">معدوم (0px - متلاصقة)</option>
                  <option value="sm">صغير (16px)</option>
                  <option value="md">متوسط (32px)</option>
                  <option value="lg">كبير (48px)</option>
                </select>
              </div>
            </div>

            <!-- BATCH DRAG & DROP ZONE (Images + Videos Together) -->
            <div class="my-6">
              <input type="file" id="input-batch-files" multiple accept="image/*,video/*" class="hidden" />
              <div
                id="dropzone-batch-media"
                class="p-8 rounded-2xl border-2 border-dashed border-sky-500/40 hover:border-sky-500 bg-sky-500/5 hover:bg-sky-500/10 transition-all flex flex-col items-center justify-center text-center cursor-pointer group"
              >
                <div
                  class="w-14 h-14 rounded-2xl bg-sky-500/10 text-sky-500 flex items-center justify-center text-2xl mb-3 group-hover:scale-110 transition-transform"
                >
                  📁
                </div>
                <h3 class="text-sm font-bold text-neutral-900 dark:text-white font-mono mb-1">
                  اسحب وأفلت مجموعة صور وفيديوهات دفعة واحدة هنا
                </h3>
                <p class="text-xs font-mono text-neutral-500 max-w-md">
                  أو <span class="text-sky-600 dark:text-sky-400 font-bold underline">اضغط لاختيار ملفات من جهازك</span>
                  (يدعم JPG, PNG, WebP, MP4, WebM معاً)
                </p>
              </div>
            </div>

            <!-- Secondary Action Buttons (Embed Link & Spacer) -->
            <div class="flex flex-wrap items-center gap-3 mb-6 pb-6 border-b border-neutral-200 dark:border-white/10">
              <button
                type="button"
                id="btn-add-batch-manual"
                class="px-4 py-2 rounded-xl bg-neutral-100 dark:bg-white/5 border border-neutral-200 dark:border-white/10 hover:border-sky-500 text-xs font-mono text-neutral-800 dark:text-neutral-200 flex items-center gap-2 cursor-pointer"
              >
                <span>➕ رفع ملفات من جهازك</span>
              </button>

              <button
                type="button"
                id="btn-add-embed-link"
                class="px-4 py-2 rounded-xl bg-neutral-100 dark:bg-white/5 border border-neutral-200 dark:border-white/10 hover:border-sky-500 text-xs font-mono text-neutral-800 dark:text-neutral-200 flex items-center gap-2 cursor-pointer"
              >
                <span>🔗 إضافة رابط (YouTube / Vimeo / URL)</span>
              </button>

              <button
                type="button"
                id="btn-add-spacer"
                class="px-4 py-2 rounded-xl bg-neutral-100 dark:bg-white/5 border border-neutral-200 dark:border-white/10 hover:border-sky-500 text-xs font-mono text-neutral-800 dark:text-neutral-200 flex items-center gap-2 cursor-pointer"
              >
                <span>↕️ إضافة فراغ مخصص (Spacer)</span>
              </button>
            </div>

            <!-- Draggable Cards List -->
            <div class="space-y-3" id="media-cards-container">
              <!-- Rendered dynamically -->
            </div>

            <div
              id="media-empty-state"
              class="py-12 text-center border-2 border-dashed border-neutral-200 dark:border-white/10 rounded-2xl text-xs font-mono text-neutral-400"
            >
              لا توجد عناصر مضافة بعد. اسحب ملفاتك إلى الصندوق أعلاه للبدء!
            </div>
          </div>

          <!-- Bottom Save & Publish Controls -->
          <div
            class="p-6 rounded-3xl bg-neutral-900 text-white dark:bg-white dark:text-black flex flex-col sm:flex-row items-center justify-between gap-4 shadow-xl"
          >
            <div>
              <h3 class="font-bold text-sm font-mono">جاهز لنشر المشروع؟</h3>
              <p class="text-xs opacity-75 font-mono">سيتم حفظ التغييرات وبناء الموقع لايف على نطاقك</p>
            </div>

            <div class="flex items-center gap-3 w-full sm:w-auto">
              <button
                type="button"
                id="btn-export-code"
                class="flex-1 sm:flex-none px-4 py-3 rounded-xl border border-white/20 dark:border-black/20 text-xs font-mono uppercase tracking-wider hover:bg-white/10 dark:hover:bg-black/10 transition-colors cursor-pointer"
              >
                نسخ كود المشروع
              </button>

              <button
                type="button"
                id="btn-publish-project"
                class="flex-1 sm:flex-none px-6 py-3 rounded-xl bg-sky-500 text-white font-bold text-xs font-mono uppercase tracking-wider hover:bg-sky-400 transition-colors shadow-lg cursor-pointer flex items-center justify-center gap-2"
              >
                <span>حفظ ونشر التعديلات 🚀</span>
              </button>
            </div>
          </div>

          <!-- Status Banner -->
          <div id="publish-status-banner" class="hidden p-4 rounded-2xl text-xs font-mono flex items-center gap-3">
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  interface MediaItem {
    type: 'youtube' | 'video' | 'image' | 'spacer';
    src?: string;
    caption?: string;
    size?: 'sm' | 'md' | 'lg' | 'xl';
    _file?: File; // Temporary local file reference for uploading
  }

  interface Project {
    slug: string;
    title: string;
    category: string;
    categoryKey: 'motion' | '3d' | 'cinematography' | 'brand' | 'ui-ux';
    year: string;
    role: string;
    specs: string;
    description: string;
    thumbnail: string;
    videoPreview?: string;
    featured?: boolean;
    mediaGap?: 'none' | 'sm' | 'md' | 'lg';
    media: MediaItem[];
  }

  function initStudioAdmin() {
    const rawData = document.getElementById('initial-projects-data')?.getAttribute('data-projects');
    const projectsList: Project[] = rawData ? JSON.parse(rawData) : [];
    let currentEditingSlug: string | null = null;
    let currentMedia: MediaItem[] = [];
    let coverFile: File | null = null;
    let previewVideoFile: File | null = null;

    // Elements
    const viewList = document.getElementById('view-projects-list');
    const viewEditor = document.getElementById('view-project-editor');
    const projectsTable = document.getElementById('projects-table');
    const countProjects = document.getElementById('count-projects');
    const mediaContainer = document.getElementById('media-cards-container');
    const mediaEmpty = document.getElementById('media-empty-state');
    const btnCreateNew = document.getElementById('btn-create-new');
    const btnBackToList = document.getElementById('btn-back-to-list');
    const btnPublish = document.getElementById('btn-publish-project');
    const btnExport = document.getElementById('btn-export-code');
    const statusBanner = document.getElementById('publish-status-banner');

    // Settings Modal
    const btnSettings = document.getElementById('btn-settings');
    const settingsModal = document.getElementById('settings-modal');
    const closeSettings = document.getElementById('close-settings');
    const btnSaveToken = document.getElementById('btn-save-token');
    const inputToken = document.getElementById('input-github-token') as HTMLInputElement | null;
    const githubBadge = document.getElementById('github-badge');

    const updateTokenBadge = () => {
      const token = localStorage.getItem('mouad_gh_token');
      if (token && githubBadge) {
        githubBadge.classList.remove('bg-amber-500');
        githubBadge.classList.add('bg-emerald-500');
      }
    };
    updateTokenBadge();

    btnSettings?.addEventListener('click', () => {
      if (inputToken) inputToken.value = localStorage.getItem('mouad_gh_token') || '';
      settingsModal?.classList.remove('opacity-0', 'pointer-events-none');
    });

    closeSettings?.addEventListener('click', () => {
      settingsModal?.classList.add('opacity-0', 'pointer-events-none');
    });

    btnSaveToken?.addEventListener('click', () => {
      if (inputToken?.value.trim()) {
        localStorage.setItem('mouad_gh_token', inputToken.value.trim());
        updateTokenBadge();
        settingsModal?.classList.add('opacity-0', 'pointer-events-none');
        alert('تم حفظ رمز GitHub بنجاح! يمكنك الآن النشر ورفع الملفات مباشرة.');
      }
    });

    // 1. Cover Thumbnail Dropzone Handler
    const dropzoneCover = document.getElementById('dropzone-cover');
    const inputCoverFile = document.getElementById('input-cover-file') as HTMLInputElement | null;
    const coverPreviewBox = document.getElementById('cover-preview-box');
    const coverPreviewImg = document.getElementById('cover-preview-img') as HTMLImageElement | null;
    const coverPlaceholder = document.getElementById('cover-placeholder');
    const btnRemoveCover = document.getElementById('btn-remove-cover');
    const formThumbnailInput = document.getElementById('form-thumbnail') as HTMLInputElement | null;

    dropzoneCover?.addEventListener('click', (e) => {
      if (e.target !== btnRemoveCover) inputCoverFile?.click();
    });

    const setCoverImage = (file: File) => {
      coverFile = file;
      const url = URL.createObjectURL(file);
      if (coverPreviewImg && coverPreviewBox && coverPlaceholder) {
        coverPreviewImg.src = url;
        coverPreviewBox.classList.remove('hidden');
        coverPlaceholder.classList.add('hidden');
      }
      if (formThumbnailInput) {
        const slug = (document.getElementById('form-slug') as HTMLInputElement).value || 'new-project';
        formThumbnailInput.value = `/projects/${slug}/${file.name}`;
      }
    };

    inputCoverFile?.addEventListener('change', () => {
      if (inputCoverFile.files?.[0]) setCoverImage(inputCoverFile.files[0]);
    });

    dropzoneCover?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzoneCover.classList.add('border-sky-500', 'bg-sky-500/10');
    });
    dropzoneCover?.addEventListener('dragleave', () => {
      dropzoneCover.classList.remove('border-sky-500', 'bg-sky-500/10');
    });
    dropzoneCover?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzoneCover.classList.remove('border-sky-500', 'bg-sky-500/10');
      if (e.dataTransfer?.files?.[0]) setCoverImage(e.dataTransfer.files[0]);
    });

    btnRemoveCover?.addEventListener('click', (e) => {
      e.stopPropagation();
      coverFile = null;
      if (coverPreviewBox && coverPlaceholder && inputCoverFile) {
        coverPreviewBox.classList.add('hidden');
        coverPlaceholder.classList.remove('hidden');
        inputCoverFile.value = '';
      }
      if (formThumbnailInput) formThumbnailInput.value = '';
    });

    // 2. Short Preview Video Dropzone Handler
    const dropzonePreviewVideo = document.getElementById('dropzone-preview-video');
    const inputPreviewVideoFile = document.getElementById('input-preview-video-file') as HTMLInputElement | null;
    const previewVideoBox = document.getElementById('preview-video-box');
    const previewVideoEl = document.getElementById('preview-video-element') as HTMLVideoElement | null;
    const previewVideoPlaceholder = document.getElementById('preview-video-placeholder');
    const btnRemovePreviewVideo = document.getElementById('btn-remove-preview-video');
    const formVideoPreviewInput = document.getElementById('form-video-preview') as HTMLInputElement | null;

    dropzonePreviewVideo?.addEventListener('click', (e) => {
      if (e.target !== btnRemovePreviewVideo) inputPreviewVideoFile?.click();
    });

    const setPreviewVideo = (file: File) => {
      previewVideoFile = file;
      const url = URL.createObjectURL(file);
      if (previewVideoEl && previewVideoBox && previewVideoPlaceholder) {
        previewVideoEl.src = url;
        previewVideoBox.classList.remove('hidden');
        previewVideoPlaceholder.classList.add('hidden');
      }
      if (formVideoPreviewInput) {
        const slug = (document.getElementById('form-slug') as HTMLInputElement).value || 'new-project';
        formVideoPreviewInput.value = `/projects/${slug}/${file.name}`;
      }
    };

    inputPreviewVideoFile?.addEventListener('change', () => {
      if (inputPreviewVideoFile.files?.[0]) setPreviewVideo(inputPreviewVideoFile.files[0]);
    });

    dropzonePreviewVideo?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzonePreviewVideo.classList.add('border-sky-500', 'bg-sky-500/10');
    });
    dropzonePreviewVideo?.addEventListener('dragleave', () => {
      dropzonePreviewVideo.classList.remove('border-sky-500', 'bg-sky-500/10');
    });
    dropzonePreviewVideo?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzonePreviewVideo.classList.remove('border-sky-500', 'bg-sky-500/10');
      if (e.dataTransfer?.files?.[0]) setPreviewVideo(e.dataTransfer.files[0]);
    });

    btnRemovePreviewVideo?.addEventListener('click', (e) => {
      e.stopPropagation();
      previewVideoFile = null;
      if (previewVideoBox && previewVideoPlaceholder && inputPreviewVideoFile && previewVideoEl) {
        previewVideoBox.classList.add('hidden');
        previewVideoPlaceholder.classList.remove('hidden');
        previewVideoEl.src = '';
        inputPreviewVideoFile.value = '';
      }
      if (formVideoPreviewInput) formVideoPreviewInput.value = '';
    });

    // 3. Category Selector & Custom Category Handler
    const categorySelect = document.getElementById('form-category-select') as HTMLSelectElement | null;
    const customCategoryBox = document.getElementById('custom-category-box');
    const customCategoryInput = document.getElementById('form-custom-category-input') as HTMLInputElement | null;
    const btnApplyCustomCategory = document.getElementById('btn-apply-custom-category');
    const btnToggleCustomCategory = document.getElementById('btn-toggle-custom-category');

    btnToggleCustomCategory?.addEventListener('click', () => {
      customCategoryBox?.classList.toggle('hidden');
    });

    categorySelect?.addEventListener('change', () => {
      if (categorySelect.value === '__custom__') {
        customCategoryBox?.classList.remove('hidden');
      }
    });

    btnApplyCustomCategory?.addEventListener('click', () => {
      const name = customCategoryInput?.value.trim();
      if (!name || !categorySelect) return;
      const key = name.toLowerCase().replace(/[^\w]/g, '-').slice(0, 15) || 'custom';
      const opt = document.createElement('option');
      opt.value = `${key}|${name}`;
      opt.textContent = name;
      categorySelect.insertBefore(opt, categorySelect.lastElementChild);
      categorySelect.value = opt.value;
      customCategoryBox?.classList.add('hidden');
    });

    // 4. Specs Ready-Made Badges
    const specsInput = document.getElementById('form-specs') as HTMLInputElement | null;
    document.querySelectorAll<HTMLButtonElement>('.spec-badge-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const badge = btn.getAttribute('data-badge') || '';
        if (!specsInput) return;
        const currentVals = specsInput.value
          .split('·')
          .map((s) => s.trim())
          .filter(Boolean);
        if (!currentVals.includes(badge)) {
          currentVals.push(badge);
        } else {
          const idx = currentVals.indexOf(badge);
          currentVals.splice(idx, 1);
        }
        specsInput.value = currentVals.join(' · ');
      });
    });

    // 5. BATCH MIXED FILES DRAG & DROP (Images and Videos together)
    const dropzoneBatch = document.getElementById('dropzone-batch-media');
    const inputBatchFiles = document.getElementById('input-batch-files') as HTMLInputElement | null;
    const btnAddBatchManual = document.getElementById('btn-add-batch-manual');

    btnAddBatchManual?.addEventListener('click', () => inputBatchFiles?.click());
    dropzoneBatch?.addEventListener('click', () => inputBatchFiles?.click());

    const handleBatchFiles = (fileList: FileList | File[]) => {
      const files = Array.from(fileList);
      const slug = (document.getElementById('form-slug') as HTMLInputElement).value || 'new-project';

      files.forEach((file) => {
        if (file.type.startsWith('image/')) {
          const previewUrl = URL.createObjectURL(file);
          currentMedia.push({
            type: 'image',
            src: `/projects/${slug}/${file.name}`,
            caption: '',
            _file: file,
          });
          // Also set object url for local preview inside card
          setTimeout(() => {
            const cardImgs = mediaContainer?.querySelectorAll<HTMLImageElement>('img.media-preview-thumb');
            if (cardImgs && cardImgs.length > 0) {
              const lastImg = cardImgs[cardImgs.length - 1];
              if (lastImg && !lastImg.src.startsWith('data:') && !lastImg.src.startsWith('blob:')) {
                lastImg.src = previewUrl;
              }
            }
          }, 50);
        } else if (file.type.startsWith('video/')) {
          currentMedia.push({
            type: 'video',
            src: `/projects/${slug}/${file.name}`,
            _file: file,
          });
        }
      });

      renderMediaCards();
    };

    inputBatchFiles?.addEventListener('change', () => {
      if (inputBatchFiles.files) handleBatchFiles(inputBatchFiles.files);
    });

    dropzoneBatch?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzoneBatch.classList.add('border-sky-500', 'bg-sky-500/20');
    });
    dropzoneBatch?.addEventListener('dragleave', () => {
      dropzoneBatch.classList.remove('border-sky-500', 'bg-sky-500/20');
    });
    dropzoneBatch?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzoneBatch.classList.remove('border-sky-500', 'bg-sky-500/20');
      if (e.dataTransfer?.files) handleBatchFiles(e.dataTransfer.files);
    });

    // 6. Secondary Add Buttons (Embed link & Spacer)
    const btnAddEmbedLink = document.getElementById('btn-add-embed-link');
    const btnAddSpacer = document.getElementById('btn-add-spacer');

    btnAddEmbedLink?.addEventListener('click', () => {
      const url = prompt('أدخل رابط YouTube Embed أو رابط فيديو مباشر:', 'https://www.youtube-nocookie.com/embed/');
      if (url) {
        const isYt = url.includes('youtube') || url.includes('youtu.be');
        currentMedia.push({
          type: isYt ? 'youtube' : 'video',
          src: url,
        });
        renderMediaCards();
      }
    });

    btnAddSpacer?.addEventListener('click', () => {
      currentMedia.push({ type: 'spacer', size: 'md' });
      renderMediaCards();
    });

    // 7. Render Drag & Drop Media Cards
    const renderMediaCards = () => {
      if (!mediaContainer || !mediaEmpty) return;
      mediaContainer.innerHTML = '';

      if (currentMedia.length === 0) {
        mediaEmpty.classList.remove('hidden');
      } else {
        mediaEmpty.classList.add('hidden');
      }

      currentMedia.forEach((item, index) => {
        const card = document.createElement('div');
        card.draggable = true;
        card.className =
          'media-draggable-card group flex items-center justify-between p-4 rounded-2xl border border-neutral-200 dark:border-white/10 bg-white/90 dark:bg-neutral-950/80 shadow-sm transition-all text-xs font-mono';
        card.setAttribute('data-index', String(index));

        if (item.type === 'spacer') {
          card.innerHTML = `
            <div class="flex items-center gap-3">
              <span class="cursor-grab text-neutral-400 group-hover:text-neutral-900 dark:group-hover:text-white text-base">⋮⋮</span>
              <span class="px-2.5 py-1 rounded-lg bg-sky-500/10 text-sky-500 font-bold flex items-center gap-1.5">
                <span>↕️</span>
                <span>فراغ مخصص (Spacer)</span>
              </span>
              <select class="spacer-size-select px-2.5 py-1 rounded-md bg-neutral-100 dark:bg-neutral-800 border border-neutral-300 dark:border-white/10 text-neutral-900 dark:text-white cursor-pointer">
                <option value="sm" ${item.size === 'sm' ? 'selected' : ''}>صغير (24px)</option>
                <option value="md" ${item.size === 'md' || !item.size ? 'selected' : ''}>متوسط (48px)</option>
                <option value="lg" ${item.size === 'lg' ? 'selected' : ''}>كبير (96px)</option>
                <option value="xl" ${item.size === 'xl' ? 'selected' : ''}>ضخم (140px)</option>
              </select>
            </div>
            <div class="flex items-center gap-2">
              <button type="button" class="btn-move-up p-1 hover:text-sky-500" title="تحريك لأعلى">▲</button>
              <button type="button" class="btn-move-down p-1 hover:text-sky-500" title="تحريك لأسفل">▼</button>
              <button type="button" class="btn-remove-item text-red-500 hover:text-red-700 p-1" title="حذف">✕</button>
            </div>
          `;
        } else if (item.type === 'image') {
          const imgSrc = item._file ? URL.createObjectURL(item._file) : item.src || '';
          card.innerHTML = `
            <div class="flex items-center gap-3 overflow-hidden">
              <span class="cursor-grab text-neutral-400 group-hover:text-neutral-900 dark:group-hover:text-white text-base">⋮⋮</span>
              <div class="w-14 h-12 rounded-lg overflow-hidden bg-neutral-900 flex-shrink-0 border border-neutral-300 dark:border-white/10">
                <img src="${imgSrc}" class="media-preview-thumb w-full h-full object-cover" onerror="this.src='https://placehold.co/100x70?text=Image'" />
              </div>
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="text-[10px] uppercase font-bold text-sky-500">صورة (Image)</span>
                  ${item._file ? `<span class="text-[9px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-500">ملف جاهز للرفع: ${item._file.name}</span>` : ''}
                </div>
                <input type="text" value="${item.src || ''}" placeholder="مسار الصورة" class="card-src-input block w-60 sm:w-80 px-2 py-1 rounded bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-white/10 text-xs" />
                <input type="text" value="${item.caption || ''}" placeholder="وصف الصورة (Caption)" class="card-caption-input block w-60 sm:w-80 px-2 py-0.5 rounded bg-transparent border-b border-neutral-200 dark:border-white/10 text-[11px] text-neutral-400" />
              </div>
            </div>
            <div class="flex items-center gap-2">
              <button type="button" class="btn-move-up p-1 hover:text-sky-500">▲</button>
              <button type="button" class="btn-move-down p-1 hover:text-sky-500">▼</button>
              <button type="button" class="btn-remove-item text-red-500 hover:text-red-700 p-1">✕</button>
            </div>
          `;
        } else {
          // Video / YouTube
          card.innerHTML = `
            <div class="flex items-center gap-3 overflow-hidden">
              <span class="cursor-grab text-neutral-400 group-hover:text-neutral-900 dark:group-hover:text-white text-base">⋮⋮</span>
              <span class="p-2 rounded-lg bg-indigo-500/10 text-indigo-500 font-bold">🎬 فيديو</span>
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <select class="card-type-select px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-white/10 text-[10px] font-bold">
                    <option value="video" ${item.type === 'video' ? 'selected' : ''}>فيديو مباشر (WebM/MP4)</option>
                    <option value="youtube" ${item.type === 'youtube' ? 'selected' : ''}>YouTube Embed</option>
                  </select>
                  ${item._file ? `<span class="text-[9px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-500">ملف جاهز للرفع: ${item._file.name}</span>` : ''}
                </div>
                <input type="text" value="${item.src || ''}" placeholder="رابط الفيديو" class="card-src-input block w-60 sm:w-80 px-2 py-1 rounded bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-white/10 text-xs" />
              </div>
            </div>
            <div class="flex items-center gap-2">
              <button type="button" class="btn-move-up p-1 hover:text-sky-500">▲</button>
              <button type="button" class="btn-move-down p-1 hover:text-sky-500">▼</button>
              <button type="button" class="btn-remove-item text-red-500 hover:text-red-700 p-1">✕</button>
            </div>
          `;
        }

        // Card events
        card.querySelector('.spacer-size-select')?.addEventListener('change', (e) => {
          currentMedia[index].size = (e.target as HTMLSelectElement).value as MediaItem['size'];
        });

        card.querySelector('.card-src-input')?.addEventListener('input', (e) => {
          currentMedia[index].src = (e.target as HTMLInputElement).value;
        });

        card.querySelector('.card-caption-input')?.addEventListener('input', (e) => {
          currentMedia[index].caption = (e.target as HTMLInputElement).value;
        });

        card.querySelector('.card-type-select')?.addEventListener('change', (e) => {
          currentMedia[index].type = (e.target as HTMLSelectElement).value as MediaItem['type'];
        });

        card.querySelector('.btn-move-up')?.addEventListener('click', () => {
          if (index > 0) {
            const temp = currentMedia[index];
            currentMedia[index] = currentMedia[index - 1];
            currentMedia[index - 1] = temp;
            renderMediaCards();
          }
        });

        card.querySelector('.btn-move-down')?.addEventListener('click', () => {
          if (index < currentMedia.length - 1) {
            const temp = currentMedia[index];
            currentMedia[index] = currentMedia[index + 1];
            currentMedia[index + 1] = temp;
            renderMediaCards();
          }
        });

        card.querySelector('.btn-remove-item')?.addEventListener('click', () => {
          currentMedia.splice(index, 1);
          renderMediaCards();
        });

        // HTML5 Drag and Drop Reordering
        card.addEventListener('dragstart', (e) => {
          e.dataTransfer?.setData('text/plain', String(index));
          card.classList.add('opacity-50');
        });

        card.addEventListener('dragend', () => card.classList.remove('opacity-50'));

        card.addEventListener('dragover', (e) => {
          e.preventDefault();
          card.classList.add('border-sky-500');
        });

        card.addEventListener('dragleave', () => card.classList.remove('border-sky-500'));

        card.addEventListener('drop', (e) => {
          e.preventDefault();
          card.classList.remove('border-sky-500');
          const sourceIdx = Number(e.dataTransfer?.getData('text/plain'));
          const targetIdx = index;
          if (!isNaN(sourceIdx) && sourceIdx !== targetIdx) {
            const moved = currentMedia.splice(sourceIdx, 1)[0];
            currentMedia.splice(targetIdx, 0, moved);
            renderMediaCards();
          }
        });

        mediaContainer.appendChild(card);
      });
    };

    // 8. Projects Overview List
    const renderProjectsList = () => {
      if (!projectsTable || !countProjects) return;
      countProjects.textContent = String(projectsList.length);
      projectsTable.innerHTML = '';

      projectsList.forEach((proj) => {
        const card = document.createElement('div');
        card.className =
          'rounded-2xl border border-neutral-200 dark:border-white/10 bg-white/80 dark:bg-neutral-900/80 p-5 shadow-sm hover:shadow-md transition-all flex flex-col justify-between';
        card.innerHTML = `
          <div>
            <div class="aspect-video rounded-xl overflow-hidden bg-neutral-950 mb-4 border border-neutral-200 dark:border-white/10 relative">
              <img src="${proj.thumbnail}" alt="${proj.title}" class="w-full h-full object-cover" />
              <span class="absolute top-2 right-2 px-2 py-0.5 rounded bg-black/70 text-white text-[10px] font-mono uppercase">${proj.category}</span>
            </div>
            <h3 class="text-base font-bold text-neutral-900 dark:text-white mb-1">${proj.title}</h3>
            <p class="text-xs font-mono text-neutral-500 mb-2">${proj.year} · ${proj.role || 'Creator'}</p>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 line-clamp-2 mb-4 font-mono">${proj.description || ''}</p>
          </div>

          <div class="flex items-center justify-between pt-4 border-t border-neutral-100 dark:border-white/5 font-mono text-xs">
            <span class="text-neutral-400">${proj.media.length} عنصر</span>
            <div class="flex items-center gap-2">
              <a href="/work/${proj.slug}" target="_blank" class="px-2.5 py-1 rounded-lg text-neutral-500 hover:text-sky-500 transition-colors">عرض ↗</a>
              <button type="button" class="btn-edit-proj px-3 py-1 rounded-lg bg-neutral-900 text-white dark:bg-white dark:text-black font-semibold cursor-pointer" data-slug="${proj.slug}">تعديل</button>
            </div>
          </div>
        `;

        card.querySelector('.btn-edit-proj')?.addEventListener('click', () => openEditor(proj));
        projectsTable.appendChild(card);
      });
    };

    // 9. Open Editor Mode
    const openEditor = (proj?: Project) => {
      viewList?.classList.add('hidden');
      viewEditor?.classList.remove('hidden');
      coverFile = null;
      previewVideoFile = null;

      if (proj) {
        currentEditingSlug = proj.slug;
        (document.getElementById('form-title') as HTMLInputElement).value = proj.title;
        (document.getElementById('form-slug') as HTMLInputElement).value = proj.slug;
        (document.getElementById('form-year') as HTMLInputElement).value = proj.year;
        (document.getElementById('form-role') as HTMLInputElement).value = proj.role;
        (document.getElementById('form-specs') as HTMLInputElement).value = proj.specs;
        (document.getElementById('form-thumbnail') as HTMLInputElement).value = proj.thumbnail;
        (document.getElementById('form-video-preview') as HTMLInputElement).value = proj.videoPreview || '';
        (document.getElementById('form-description') as HTMLTextAreaElement).value = proj.description;
        (document.getElementById('form-media-gap') as HTMLSelectElement).value = proj.mediaGap || 'none';

        // Select category
        if (categorySelect) {
          const matchVal = `${proj.categoryKey}|${proj.category}`;
          const existingOpt = Array.from(categorySelect.options).find(
            (o) => o.value === matchVal || o.value.startsWith(`${proj.categoryKey}|`)
          );
          if (existingOpt) {
            categorySelect.value = existingOpt.value;
          } else {
            const opt = document.createElement('option');
            opt.value = `${proj.categoryKey}|${proj.category}`;
            opt.textContent = proj.category;
            categorySelect.insertBefore(opt, categorySelect.lastElementChild);
            categorySelect.value = opt.value;
          }
        }

        // Cover preview
        if (proj.thumbnail && coverPreviewBox && coverPreviewImg && coverPlaceholder) {
          coverPreviewImg.src = proj.thumbnail;
          coverPreviewBox.classList.remove('hidden');
          coverPlaceholder.classList.add('hidden');
        }

        // Preview video
        if (proj.videoPreview && previewVideoBox && previewVideoEl && previewVideoPlaceholder) {
          previewVideoEl.src = proj.videoPreview;
          previewVideoBox.classList.remove('hidden');
          previewVideoPlaceholder.classList.add('hidden');
        }

        currentMedia = JSON.parse(JSON.stringify(proj.media || []));
      } else {
        currentEditingSlug = null;
        (document.getElementById('form-title') as HTMLInputElement).value = '';
        (document.getElementById('form-slug') as HTMLInputElement).value = '';
        (document.getElementById('form-year') as HTMLInputElement).value = String(new Date().getFullYear());
        (document.getElementById('form-role') as HTMLInputElement).value = 'Senior Motion Designer';
        (document.getElementById('form-specs') as HTMLInputElement).value = 'After Effects · Cinema 4D · 60fps';
        (document.getElementById('form-thumbnail') as HTMLInputElement).value = '';
        (document.getElementById('form-video-preview') as HTMLInputElement).value = '';
        (document.getElementById('form-description') as HTMLTextAreaElement).value = '';
        (document.getElementById('form-media-gap') as HTMLSelectElement).value = 'none';

        if (coverPreviewBox && coverPlaceholder) {
          coverPreviewBox.classList.add('hidden');
          coverPlaceholder.classList.remove('hidden');
        }
        if (previewVideoBox && previewVideoPlaceholder) {
          previewVideoBox.classList.add('hidden');
          previewVideoPlaceholder.classList.remove('hidden');
        }

        currentMedia = [];
      }

      renderMediaCards();
    };

    btnCreateNew?.addEventListener('click', () => openEditor());

    btnBackToList?.addEventListener('click', () => {
      viewEditor?.classList.add('hidden');
      viewList?.classList.remove('hidden');
      renderProjectsList();
    });

    // Auto-generate slug
    document.getElementById('form-title')?.addEventListener('input', (e) => {
      if (!currentEditingSlug) {
        const val = (e.target as HTMLInputElement).value;
        const slug = val
          .toLowerCase()
          .replace(/[^\w\s-]/g, '')
          .replace(/[\s_-]+/g, '-')
          .replace(/^-+|-+$/g, '');
        (document.getElementById('form-slug') as HTMLInputElement).value = slug;
      }
    });

    // Helper: Convert File to Base64
    const fileToBase64 = (file: File): Promise<string> =>
      new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = () => {
          const res = reader.result as string;
          // remove "data:...;base64," prefix
          const base64 = res.split(',')[1];
          resolve(base64);
        };
        reader.onerror = (err) => reject(err);
      });

    // Build Project Object
    const buildProjectObject = (): Project => {
      const title = (document.getElementById('form-title') as HTMLInputElement).value.trim();
      const slug = (document.getElementById('form-slug') as HTMLInputElement).value.trim();
      const year = (document.getElementById('form-year') as HTMLInputElement).value.trim() || '2026';
      const role = (document.getElementById('form-role') as HTMLInputElement).value.trim() || 'Lead Artist';
      const specs =
        (document.getElementById('form-specs') as HTMLInputElement).value.trim() || 'After Effects · Cinema 4D';
      const thumbnail =
        (document.getElementById('form-thumbnail') as HTMLInputElement).value.trim() ||
        'https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=1200&q=80';
      const videoPreview =
        (document.getElementById('form-video-preview') as HTMLInputElement).value.trim() || undefined;
      const description = (document.getElementById('form-description') as HTMLTextAreaElement).value.trim();
      const mediaGap = (document.getElementById('form-media-gap') as HTMLSelectElement).value as Project['mediaGap'];

      const catVal = categorySelect?.value || 'motion|Motion Design';
      const [categoryKey, category] = catVal.split('|') as [Project['categoryKey'], string];

      // Strip temporary _file references
      const cleanMedia = currentMedia.map((m) => {
        const copy: MediaItem = { type: m.type };
        if (m.src) copy.src = m.src;
        if (m.caption) copy.caption = m.caption;
        if (m.size) copy.size = m.size;
        return copy;
      });

      return {
        slug,
        title,
        category: category || 'Motion Design',
        categoryKey: categoryKey || 'motion',
        year,
        role,
        specs,
        description,
        thumbnail,
        videoPreview,
        mediaGap,
        media: cleanMedia,
      };
    };

    // Export code
    btnExport?.addEventListener('click', () => {
      const proj = buildProjectObject();
      prompt('كود المشروع جاهز للنسخ:', JSON.stringify(proj, null, 2));
    });

    // 10. Publish to GitHub with File Uploads
    btnPublish?.addEventListener('click', async () => {
      const proj = buildProjectObject();
      if (!proj.title || !proj.slug) {
        alert('يرجى كتابة عنوان المشروع والرابط (Slug).');
        return;
      }

      const token = localStorage.getItem('mouad_gh_token');
      if (!token) {
        btnSettings?.click();
        alert('يرجى إدخال رمز GitHub Personal Access Token أولاً للتمكن من النشر.');
        return;
      }

      if (!statusBanner) return;
      statusBanner.className =
        'p-4 rounded-2xl text-xs font-mono flex items-center gap-3 bg-sky-500/10 border border-sky-500/30 text-sky-800 dark:text-sky-300';
      statusBanner.innerHTML = '<span>⏳</span><span>جاري معالجة ورفع الملفات إلى GitHub...</span>';
      statusBanner.classList.remove('hidden');

      const repoOwner = 'mouad-R';
      const repoName = 'portfolio';

      try {
        // Upload Cover File if local
        if (coverFile) {
          statusBanner.innerHTML = `<span>⏳</span><span>جاري رفع صورة الغلاف (${coverFile.name})...</span>`;
          const base64 = await fileToBase64(coverFile);
          const uploadPath = `public/projects/${proj.slug}/${coverFile.name}`;

          await fetch(`https://api.github.com/repos/${repoOwner}/${repoName}/contents/${uploadPath}`, {
            method: 'PUT',
            headers: {
              Authorization: `Bearer ${token}`,
              Accept: 'application/vnd.github.v3+json',
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              message: `upload: cover for ${proj.title}`,
              content: base64,
              branch: 'main',
            }),
          });
          proj.thumbnail = `/projects/${proj.slug}/${coverFile.name}`;
        }

        // Upload Preview Video if local
        if (previewVideoFile) {
          statusBanner.innerHTML = `<span>⏳</span><span>جاري رفع معاينة الفيديو (${previewVideoFile.name})...</span>`;
          const base64 = await fileToBase64(previewVideoFile);
          const uploadPath = `public/projects/${proj.slug}/${previewVideoFile.name}`;

          await fetch(`https://api.github.com/repos/${repoOwner}/${repoName}/contents/${uploadPath}`, {
            method: 'PUT',
            headers: {
              Authorization: `Bearer ${token}`,
              Accept: 'application/vnd.github.v3+json',
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              message: `upload: preview video for ${proj.title}`,
              content: base64,
              branch: 'main',
            }),
          });
          proj.videoPreview = `/projects/${proj.slug}/${previewVideoFile.name}`;
        }

        // Upload any local media files
        const filesToUpload = currentMedia.filter((m) => m._file);
        for (let i = 0; i < filesToUpload.length; i++) {
          const item = filesToUpload[i];
          const file = item._file!;
          statusBanner.innerHTML = `<span>⏳</span><span>جاري رفع وسائط المشروع (${i + 1}/${filesToUpload.length}: ${file.name})...</span>`;
          const base64 = await fileToBase64(file);
          const uploadPath = `public/projects/${proj.slug}/${file.name}`;

          await fetch(`https://api.github.com/repos/${repoOwner}/${repoName}/contents/${uploadPath}`, {
            method: 'PUT',
            headers: {
              Authorization: `Bearer ${token}`,
              Accept: 'application/vnd.github.v3+json',
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              message: `upload: ${file.name} for ${proj.title}`,
              content: base64,
              branch: 'main',
            }),
          });
          item.src = `/projects/${proj.slug}/${file.name}`;
        }

        // Update projects array in memory
        const existingIdx = projectsList.findIndex((p) => p.slug === proj.slug);
        if (existingIdx >= 0) {
          projectsList[existingIdx] = proj;
        } else {
          projectsList.unshift(proj);
        }

        // Fetch current SHA of projects.ts
        statusBanner.innerHTML = '<span>⏳</span><span>جاري تحديث كود المشاريع ونشر التغييرات...</span>';
        const getRes = await fetch(
          `https://api.github.com/repos/${repoOwner}/${repoName}/contents/src/data/projects.ts`,
          {
            headers: {
              Authorization: `Bearer ${token}`,
              Accept: 'application/vnd.github.v3+json',
            },
          }
        );

        if (!getRes.ok) throw new Error('فشل الوصول إلى ملف المشاريع في GitHub. تأكد من صحة الرمز.');
        const fileData = await getRes.json();
        const sha = fileData.sha;

        const updatedTsContent = `export type MediaItemType = 'youtube' | 'video' | 'image' | 'spacer';

export interface MediaItem {
  type: MediaItemType;
  src?: string;
  caption?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
}

export type ProjectCategory = 'motion' | '3d' | 'cinematography' | 'brand' | 'ui-ux';

export interface Project {
  slug: string;
  title: string;
  category: string;
  categoryKey: ProjectCategory;
  year: string;
  role: string;
  specs: string;
  description: string;
  thumbnail: string;
  videoPreview?: string;
  featured?: boolean;
  mediaGap?: 'none' | 'sm' | 'md' | 'lg';
  media: MediaItem[];
}

export const projects: Project[] = ${JSON.stringify(projectsList, null, 2)};
`;

        const utf8Bytes = new TextEncoder().encode(updatedTsContent);
        let binaryStr = '';
        utf8Bytes.forEach((b) => (binaryStr += String.fromCharCode(b)));
        const base64Ts = btoa(binaryStr);

        const putRes = await fetch(
          `https://api.github.com/repos/${repoOwner}/${repoName}/contents/src/data/projects.ts`,
          {
            method: 'PUT',
            headers: {
              Authorization: `Bearer ${token}`,
              Accept: 'application/vnd.github.v3+json',
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              message: `feat(work): update project "${proj.title}" via Studio Admin`,
              content: base64Ts,
              sha,
              branch: 'main',
            }),
          }
        );

        if (!putRes.ok) {
          const errData = await putRes.json();
          throw new Error(errData.message || 'حدث خطأ أثناء حفظ الملف في GitHub.');
        }

        // Success!
        statusBanner.className =
          'p-4 rounded-2xl text-xs font-mono flex items-center gap-3 bg-emerald-500/10 border border-emerald-500/30 text-emerald-800 dark:text-emerald-300';
        statusBanner.innerHTML =
          '<span>✓</span><span>تم الحفظ والنشر بنجاح على GitHub! سيقوم الخادم ببناء ونشر المشروع لايف على موقعك خلال 60 ثانية.</span>';

        renderProjectsList();
      } catch (err: unknown) {
        const errorMsg = err instanceof Error ? err.message : String(err);
        statusBanner.className =
          'p-4 rounded-2xl text-xs font-mono flex items-center gap-3 bg-red-500/10 border border-red-500/30 text-red-800 dark:text-red-300';
        statusBanner.innerHTML = `<span>✕</span><span>خطأ: ${errorMsg}</span>`;
      }
    });

    renderProjectsList();
  }

  initStudioAdmin();
  document.addEventListener('astro:page-load', initStudioAdmin);
</script>
