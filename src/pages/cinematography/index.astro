---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import { cinemaProjects } from '~/data/cinematography';

const metadata = {
  title: 'Cinematography & Direction — Mouad Rouini',
  description: 'Selected works in cinematography, lighting, and color grading.',
};
---

<Layout metadata={metadata}>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 pb-28">
    <header class="mb-12">
      <span class="text-xs font-mono uppercase tracking-widest text-sky-600 dark:text-sky-400 block mb-2 font-bold"
        >Portfolio</span
      >
      <h1 class="text-3xl md:text-5xl font-bold text-neutral-900 dark:text-white tracking-tight">Cinematography</h1>
      <p class="mt-3 text-neutral-600 dark:text-neutral-400 max-w-lg text-sm md:text-base font-normal">
        Selected commercial projects, narrative works, and color grading breakdowns.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {
        cinemaProjects.map((project) => (
          <a
            href={`/cinematography/${project.slug}`}
            class="group block cursor-pointer focus:outline-none intersect-once intersect:opacity-100 intersect:translate-y-0 opacity-0 translate-y-6 duration-700"
          >
            <div class="relative w-full aspect-video rounded-xl overflow-hidden bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800/80 mb-3.5 shadow-sm group-hover:border-sky-500/50 transition-colors">
              <img
                src={project.thumbnail}
                alt={project.title}
                class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-black/10 dark:bg-black/25 group-hover:bg-transparent transition-colors duration-300" />
            </div>

            <div class="flex items-start justify-between gap-3">
              <div>
                <h2 class="text-base md:text-lg font-semibold text-neutral-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors duration-200">
                  {project.title}
                </h2>
                <p class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400 mt-0.5 uppercase tracking-wider">
                  {project.role}
                </p>
              </div>

              <div class="text-right flex-shrink-0">
                <span class="text-[11px] font-mono text-neutral-400 dark:text-neutral-500 block">{project.year}</span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
