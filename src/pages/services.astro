---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Services — How I Help | Mouad Rouini',
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    tagline="Capabilities & Services"
    actions={[
      { variant: 'primary', text: 'Get in Touch', href: '/contact', icon: 'tabler:arrow-right' }
    ]}
  >
    <Fragment slot="title">
      End-to-end visual execution for <br />
      <span class="text-sky-600 dark:text-sky-400 dark:text-white highlight">brands, agencies & studios.</span>
    </Fragment>

    <Fragment slot="subtitle">
      From initial concept boards to final color-graded delivery — bridging creative direction with technical post-production workflows.
    </Fragment>
  </Hero>

  <!-- Services Grid -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- 1. Motion & Broadcast -->
      <div class="p-8 rounded-2xl bg-neutral-900 border border-neutral-800 hover:border-neutral-600 transition-all">
        <span class="text-xs font-mono uppercase tracking-widest text-sky-600 dark:text-sky-400">01 / Motion Design</span>
        <h3 class="text-2xl font-bold mt-3 mb-4">Kinetic Motion & Broadcast</h3>
        <p class="text-neutral-400 text-sm leading-relaxed mb-6">
          Dynamic brand identities, kinetic typography, promotional teasers, and broadcast packages crafted with seamless pacing and rhythm.
        </p>
        <ul class="text-xs text-neutral-300 space-y-2 border-t border-neutral-800 pt-4 font-mono">
          <li>+ 2D/3D Kinetic Typography</li>
          <li>+ Brand Identity Systems in Motion</li>
          <li>+ Social & Advertising Campaigns</li>
        </ul>
      </div>

      <!-- 2. 3D & CGI Visualization -->
      <div class="p-8 rounded-2xl bg-neutral-900 border border-neutral-800 hover:border-neutral-600 transition-all">
        <span class="text-xs font-mono uppercase tracking-widest text-sky-600 dark:text-sky-400">02 / 3D & CGI</span>
        <h3 class="text-2xl font-bold mt-3 mb-4">Product Visualization & CGI</h3>
        <p class="text-neutral-400 text-sm leading-relaxed mb-6">
          Photorealistic materials, studio lighting simulation, and cinematic camera choreography for commercial packaging and spatial concepts.
        </p>
        <ul class="text-xs text-neutral-300 space-y-2 border-t border-neutral-800 pt-4 font-mono">
          <li>+ Photorealistic Packaging & Shading</li>
          <li>+ Spatial & Architectural Concept Visuals</li>
          <li>+ High-End Product Commercials</li>
        </ul>
      </div>

      <!-- 3. Editing & Color Grading -->
      <div class="p-8 rounded-2xl bg-neutral-900 border border-neutral-800 hover:border-neutral-600 transition-all">
        <span class="text-xs font-mono uppercase tracking-widest text-sky-600 dark:text-sky-400">03 / Post-Production</span>
        <h3 class="text-2xl font-bold mt-3 mb-4">Cinematography & Color Suite</h3>
        <p class="text-neutral-400 text-sm leading-relaxed mb-6">
          Precision editing and cinematic color grading with custom film emulation transforms and strict delivery standards.
        </p>
        <ul class="text-xs text-neutral-300 space-y-2 border-t border-neutral-800 pt-4 font-mono">
          <li>+ Commercial Montage & Film Pacing</li>
          <li>+ Advanced DaVinci Resolve Color Grading</li>
          <li>+ Sound Design & Rhythm Synchronization</li>
        </ul>
      </div>

      <!-- 4. Production Direction & AI Pipelines -->
      <div class="p-8 rounded-2xl bg-neutral-900 border border-neutral-800 hover:border-neutral-600 transition-all">
        <span class="text-xs font-mono uppercase tracking-widest text-sky-600 dark:text-sky-400">04 / Leadership</span>
        <h3 class="text-2xl font-bold mt-3 mb-4">Creative Direction & AI Workflows</h3>
        <p class="text-neutral-400 text-sm leading-relaxed mb-6">
          Supervising media pipelines from initial pitch to final master, leveraging state-of-the-art generative tools for rapid pre-visualization.
        </p>
        <ul class="text-xs text-neutral-300 space-y-2 border-t border-neutral-800 pt-4 font-mono">
          <li>+ Pipeline & Production Supervision</li>
          <li>+ Rapid Generative Storyboarding</li>
          <li>+ Creative Consultation & Technical Feasibility</li>
        </ul>
      </div>

    </div>
  </section>

  <!-- Call To Action -->
  <CallToAction
    actions={[
      { variant: 'primary', text: "Let's Talk Business", href: '/contact', icon: 'tabler:mail' }
    ]}
  >
    <Fragment slot="title">Need specialized creative execution for your next campaign?</Fragment>
    <Fragment slot="subtitle">Let's discuss pipeline requirements, delivery milestones, and creative direction.</Fragment>
  </CallToAction>
</Layout>
